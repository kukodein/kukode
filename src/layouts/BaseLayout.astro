---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import AnalyticsHead from '../components/AnalyticsHead.astro';
import AnalyticsBody from '../components/AnalyticsBody.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import BackToTop from '../components/BackToTop.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noindex?: boolean;
  schema?: object;
  alternateEn?: string;
  alternateId?: string;
  headerAlternateUrl?: string;
  canonical?: string;
}

const currentLocale = Astro.currentLocale || 'en';
const {
  title,
  description = 'Kukode Digital Technology gives the services to improve your company\'s expansion & online presence.',
  image = '/image/default-thumbnail.jpg',
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  noindex = false,
  schema,
  alternateEn,
  alternateId,
  headerAlternateUrl,
  canonical,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={currentLocale} data-bs-theme="light">
  <head>
    <!-- Anti-FOUC: Apply saved or system theme immediately -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('kk-theme');
        const systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (systemDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-bs-theme', theme);

        if (window.matchMedia) {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
            if (!localStorage.getItem('kk-theme')) {
              document.documentElement.setAttribute('data-bs-theme', e.matches ? 'dark' : 'light');
            }
          });
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SEOHead
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      noindex={noindex}
      schema={schema}
      alternateEn={alternateEn}
      alternateId={alternateId}
      canonical={canonical}
    />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preload Critical Fonts -->
    <link rel="preload" href="/fonts/Inter-VariableFont_opsz,wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GoogleSans-VariableFont_GRAD,opsz,wght.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Bootstrap CSS -->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Custom Styles -->
    <link href="/css/kukode.css" rel="stylesheet" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={currentLocale === 'id' ? 'Kukode Blog (ID)' : 'Kukode Blog (EN)'} href={currentLocale === 'id' ? '/id/rss.xml' : '/rss.xml'} />

    <!-- ClientRouter for fast page transitions -->
    <ClientRouter />

    <!-- Google Analytics & Google Tag Manager -->
    <AnalyticsHead />

    <slot name="head" />
  </head>
  <body>
    <!-- Skip to main content (A11y) -->
    <a href="#main-content" class="kk-skip-link">
      {currentLocale === 'id' ? 'Menuju ke konten utama' : 'Skip to main content'}
    </a>

    <!-- Google Tag Manager (noscript) -->
    <AnalyticsBody />

    <Header alternateUrl={headerAlternateUrl || (currentLocale === 'id' ? alternateEn : alternateId)} />

    <div id="main-content">
      <slot />
    </div>

    <Footer />

    <!-- Floating WhatsApp CTA & Back to Top -->
    <WhatsAppWidget />
    <BackToTop />
    <CookieConsent />

    <!-- Bootstrap JS -->
    <script is:inline src="/vendor/bootstrap/js/bootstrap.min.js"></script>
    <!-- Global Scripts -->
    <script is:inline src="/js/kukode-global.js"></script>

    <!-- Re-init on client-side navigation -->
    <script is:inline>
      function applyTheme() {
        const saved = localStorage.getItem('kk-theme');
        const systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (systemDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-bs-theme', theme);
      }
      document.addEventListener('astro:after-swap', applyTheme);

      // Global event delegation for dark mode toggle (always works with ClientRouter)
      document.addEventListener('click', function (e) {
        const btn = e.target.closest('#themeToggle, #themeToggleMobile, .kk-theme-toggle');
        if (!btn) return;
        const current = document.documentElement.getAttribute('data-bs-theme') || 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-bs-theme', next);
        localStorage.setItem('kk-theme', next);
      });
    </script>

    <slot name="scripts" />
  </body>
</html>
