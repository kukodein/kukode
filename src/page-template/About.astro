---
interface Props {
  page: any;
  pageData?: any;
  contentHtml?: string | null;
}

const { page, pageData, contentHtml } = Astro.props;
const title = pageData?.title || page?.data?.title || 'About Us';
const hero = pageData?.hero || {};
const heroTitle = hero.hero_title || title;
const heroDescription = hero.hero_description || page?.data?.description || '';
const heroImage = hero.hero_image || null;
---

<main class="kk-template-page">
  <!-- Hero Section -->
  <section class="kk-hero py-5 border-bottom">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class={heroImage ? "col-lg-7 text-start" : "col-lg-8 mx-auto text-center"}>
          <nav class="kk-badge-pill kk-breadcrumb-nav mb-3" aria-label="breadcrumb">
            <span class="kk-dot"></span>
            <a href="/" class="text-decoration-none">Home</a>
            <span class="mx-1 text-muted-kk">/</span>
            <span class="text-muted-kk">{title}</span>
          </nav>
          <h1 class="display-5 fw-bold mb-3">{heroTitle}</h1>
          {heroDescription && (
            <p class="lead text-muted-kk mb-0">{heroDescription}</p>
          )}
        </div>
        {heroImage && (
          <div class="col-lg-5">
            <div class="p-2">
              <img
                src={heroImage}
                alt={heroTitle}
                class="img-fluid rounded-3 w-100 object-fit-cover"
                style="max-height: 400px;"
                loading="eager"
              />
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="kk-section py-5">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 mx-auto">
          <div class="article-body">
            {contentHtml ? (
              <div set:html={contentHtml} />
            ) : (
              <slot />
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

