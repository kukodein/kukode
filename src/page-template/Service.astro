    question: 'Why is Kukode\'s Jamstack architecture significantly more secure than traditional WordPress?',
    answer: 'We build with modern static compilation (Astro SSG). Without exposed MySQL databases or PHP runtime vulnerabilities, your website is completely impervious to brute-force attacks and malware injections.'
  },
  {
    question: 'Are there hidden annual plugin renewals or recurring agency retainers?',
    answer: 'None whatsoever. Our development fee is a one-time investment. You own 100% of your code and digital assets without unexpected licensing fees.'
  },
  {
    question: 'Is modern on-page SEO included from the start?',
    answer: 'Yes! Every build includes semantic markup, automated XML sitemaps, OpenGraph metadata, structured JSON-LD schemas, and sub-second load times to ensure favorable Google rankings.'
  }
];

const faqList = (pageData?.faq && Array.isArray(pageData.faq) && pageData.faq.length > 0)
  ? pageData.faq
  : defaultFaqList;

// Generate FAQ Schema JSON-LD
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqList.map((item: any) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer
    }
  }))
};

// 9. CTA Band
const defaultCtaBand = isId ? {
  heading: 'Siap Membangun Website Profil Perusahaan Terbaik?',
  description: 'Diskusikan kebutuhan perusahaan Anda langsung bersama engineer Kukode. Kami bantu analisa arsitektur, estimasi biaya transparan, dan saran struktur halaman secara gratis.',
  cta_text: 'Hubungi Kami via WhatsApp',
  cta_link: waLink,
  guarantee_text: 'Respon Cepat Tim Engineer • Konsultasi 100% Gratis • Tanpa Spam'
} : {
  heading: 'Ready to Build a High-Authority Corporate Website?',
  description: 'Speak directly with our lead software engineers. We will analyze your requirements and provide a free structural breakdown and transparent estimate.',
  cta_text: 'Chat via WhatsApp',
  cta_link: waLink,
  guarantee_text: 'Rapid Engineer Response • 100% Free Strategy Session • Zero Pressure'
};

const ctaBandData = (pageData?.cta_band && pageData.cta_band.heading)
  ? pageData.cta_band
  : defaultCtaBand;
