            <p class="kk-eyebrow mb-2">FAQ</p>
            <h2 class="display-6 font-heading fw-bold">{isId ? 'Pertanyaan yang Sering Diajukan' : 'Frequently Asked Questions'}</h2>
            <p class="text-muted-kk">{isId ? 'Transparansi penuh seputar teknis, biaya, dan kemudahan pengelolaan website.' : 'Clear, honest answers regarding deliverables, timeline, and ownership.'}</p>
          </div>

          <div class="accordion accordion-flush rounded-4 border overflow-hidden shadow-sm" id="serviceFaqAccordionV2">
            {faqList.map((faq: any, idx: number) => {
              const headingId = `faq-v2-head-${idx}`;
              const collapseId = `faq-v2-collapse-${idx}`;
              const isOpen = idx === 0;
              return (
                <div class="accordion-item bg-surface">
                  <h3 class="accordion-header" id={headingId}>
                    <button
                      class={`accordion-button ${isOpen ? '' : 'collapsed'} font-heading fw-semibold p-4`}
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target={`#${collapseId}`}
                      aria-expanded={isOpen ? 'true' : 'false'}
                      aria-controls={collapseId}
                    >
                      {faq.question}
                    </button>
                  </h3>
                  <div
                    id={collapseId}
                    class={`accordion-collapse collapse ${isOpen ? 'show' : ''}`}
                    aria-labelledby={headingId}
                    data-bs-parent="#serviceFaqAccordionV2"
                  >
                    <div class="accordion-body px-4 pb-4 pt-0 text-muted-kk leading-relaxed">
                      {faq.answer}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. HIGH IMPACT BOTTOM CTA BAND -->
  <section class="kk-section py-5">
    <div class="container">
      <div class="kk-cta-band shadow-lg">
        <p class="kk-eyebrow mb-2" style="color: rgba(255,255,255,0.85);">{isId ? 'Konsultasi Gratis Tanpa Komitmen' : 'Zero-Risk Consultation'}</p>
        <h2 class="display-6 font-heading fw-bold mb-3">{ctaBandData.heading}</h2>
        <p class="mb-4 mx-auto lead" style="max-width: 600px; font-size: 1.05rem;">
          {ctaBandData.description}
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
          <a href={ctaBandData.cta_link || waLink} target="_blank" rel="noopener noreferrer" class="btn btn-light d-inline-flex align-items-center gap-2 shadow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.001 2c5.523 0 10 4.477 10 10s-4.477 10-10 10a9.95 9.95 0 0 1-5.03-1.355L2.005 22l1.352-4.968A9.95 9.95 0 0 1 2.001 12c0-5.523 4.477-10 10-10M8.593 7.3l-.2.008a1 1 0 0 0-.372.1a1.3 1.3 0 0 0-.294.228c-.12.113-.188.211-.261.306A2.73 2.73 0 0 0 6.9 9.62c.002.49.13.967.33 1.413c.409.902 1.082 1.857 1.97 2.742c.214.213.424.427.65.626a9.45 9.45 0 0 0 3.84 2.046l.568.087c.185.01.37-.004.556-.013a2 2 0 0 0 .833-.231a5 5 0 0 0 .383-.22q.001.002.125-.09c.135-.1.218-.171.33-.288q.126-.13.21-.302c.078-.163.156-.474.188-.733c.024-.198.017-.306.014-.373c-.004-.107-.093-.218-.19-.265l-.582-.261s-.87-.379-1.402-.621a.5.5 0 0 0-.176-.041a.48.48 0 0 0-.378.127c-.005-.002-.072.055-.795.931a.35.35 0 0 1-.368.13a1.4 1.4 0 0 1-.191-.066c-.124-.052-.167-.072-.252-.108a6 6 0 0 1-1.575-1.003c-.126-.11-.243-.23-.363-.346a6.3 6.3 0 0 1-1.02-1.268l-.059-.095a1 1 0 0 1-.102-.205c-.038-.147.061-.265.061-.265s.243-.266.356-.41c.11-.14.203-.276.263-.373c.118-.19.155-.385.093-.536q-.42-1.026-.868-2.041c-.059-.134-.234-.23-.393-.249q-.081-.01-.162-.016a3 3 0 0 0-.403.004z"></path></svg>
            <span>{ctaBandData.cta_text || (isId ? 'Hubungi Kami via WhatsApp' : 'Chat via WhatsApp')}</span>
          </a>
          <a href={isId ? '/id/#contact' : '/#contact'} class="btn btn-outline-light">
            {isId ? 'Kirim Pesan Formulir' : 'Send Project Brief'}
          </a>
        </div>
        {ctaBandData.guarantee_text && (
          <div class="mt-3 small opacity-75">
            {ctaBandData.guarantee_text}
          </div>
        )}
      </div>
    </div>
  </section>
</main>
