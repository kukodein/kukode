---
interface Props {
  page: any;
  pageData?: any;
  contentHtml?: string | null;
}

const { page, pageData, contentHtml } = Astro.props;
const title = pageData?.title || page?.data?.title || 'Contact Us';
const hero = pageData?.hero || {};
const heroTitle = hero.hero_title || title;
const emailForward = pageData?.form_email_forward || 'hello@kukode.com';
---

<main class="kk-template-page">
  <!-- Hero Section -->
  <section class="kk-hero py-5 border-bottom">
    <div class="container text-center">
      <nav class="kk-badge-pill kk-breadcrumb-nav mb-3" aria-label="breadcrumb">
        <span class="kk-dot"></span>
        <a href="/" class="text-decoration-none">Home</a>
        <span class="mx-1 text-muted-kk">/</span>
        <span class="text-muted-kk">{title}</span>
      </nav>
      <h1 class="display-5 fw-bold mb-3">{heroTitle}</h1>
      <p class="lead text-muted-kk mx-auto mb-0" style="max-width: 600px;">
        Have a project in mind or want to discuss how we can help your business? Let's connect.
      </p>
    </div>
  </section>

  <!-- Contact Form & Info Section -->
  <section class="kk-section py-5">
    <div class="container">
      <div class="row g-5">
        <!-- Contact Form -->
        <div class="col-lg-7">
          <div class="kk-card p-4 p-md-5">
            <h2 class="h4 font-heading mb-4">Send Us a Message</h2>
            <form action={`mailto:${emailForward}`} method="POST" enctype="text/plain">
              <div class="row g-3">
                <div class="col-md-6">
                  <label for="contactName" class="form-label small fw-semibold">Your Name</label>
                  <input
                    type="text"
                    class="form-control"
                    id="contactName"
                    name="name"
                    placeholder="e.g. John Doe"
                    required
                  />
                </div>
                <div class="col-md-6">
                  <label for="contactEmail" class="form-label small fw-semibold">Email Address</label>
                  <input
                    type="email"
                    class="form-control"
                    id="contactEmail"
                    name="email"
                    placeholder="john@example.com"
                    required
                  />
                </div>
                <div class="col-12">
                  <label for="contactSubject" class="form-label small fw-semibold">Subject</label>
                  <input
                    type="text"
                    class="form-control"
                    id="contactSubject"
                    name="subject"
                    placeholder="What would you like to discuss?"
                    required
                  />
                </div>
                <div class="col-12">
                  <label for="contactMessage" class="form-label small fw-semibold">Message</label>
                  <textarea
                    class="form-control"
                    id="contactMessage"
                    name="message"
                    rows="5"
                    placeholder="Tell us about your project, timeline, and goals..."
                    required
                  ></textarea>
                </div>
                <div class="col-12 mt-4">
                  <button type="submit" class="btn btn-primary px-4 py-2">
                    Send Message
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>

        <!-- Contact Info & Content -->
        <div class="col-lg-5">
          <div class="d-flex flex-column gap-4">
            <!-- Direct Contact Card -->
            <div class="kk-card p-4">
              <h3 class="h5 font-heading mb-3">Direct Contact</h3>
              <p class="text-muted-kk small mb-4">
                Prefer direct communication? We're responsive and ready to chat.
              </p>
              <div class="d-flex flex-column gap-3">
                <a
                  href="https://wa.me/62853293353541"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-outline-kk d-flex align-items-center justify-content-center gap-2"
                >
                  <span>💬</span> Chat via WhatsApp
                </a>
                <a
                  href={`mailto:${emailForward}`}
                  class="btn btn-outline-kk d-flex align-items-center justify-content-center gap-2"
                >
                  <span>✉️</span> {emailForward}
                </a>
              </div>
            </div>

            <!-- Page Content / Details -->
            {(contentHtml || Astro.slots.has('default')) && (
              <div class="kk-card p-4">
                <div class="article-body">
                  {contentHtml ? (
                    <div set:html={contentHtml} />
                  ) : (
                    <slot />
                  )}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

