---
import { getCollection } from 'astro:content';

interface Props {
  page: any;
  pageData?: any;
  contentHtml?: string | null;
}

const { page, pageData, contentHtml } = Astro.props;

const currentLocale = Astro.currentLocale || 'en';
const isId = currentLocale === 'id' || page?.id?.startsWith('id/');

// Fetch site settings from CMS for WhatsApp number
const allSettings = await getCollection('settings');
const siteSettings =
  allSettings.find(
    (s) => s.id === (isId ? 'id/general' : 'en/general') || s.id === (isId ? 'id/general.json' : 'en/general.json')
  )?.data ||
  allSettings.find(
    (s) => s.id === 'general' || s.id === 'general.json'
  )?.data;

const rawPhone = siteSettings?.whatsapp || '62853293353541';
const cleanPhone = rawPhone.replace(/\D/g, '');

const title = pageData?.title || page?.data?.title || (isId ? 'Hubungi Kami' : 'Contact Us');
const hero = pageData?.hero || {};
const heroTitle = hero.hero_title || title;
const emailForward = pageData?.form_email_forward || 'hello@kukode.com';

const heroSubtitle = isId
  ? 'Punya ide proyek atau ingin mendiskusikan bagaimana kami dapat membantu bisnis Anda? Mari terhubung.'
  : "Have a project in mind or want to discuss how we can help your business? Let's connect.";
---

<main class="kk-template-page">
  <!-- Hero Section -->
  <section class="kk-hero py-5 border-bottom">
    <div class="container text-center">
      <nav class="kk-badge-pill kk-breadcrumb-nav mb-3" aria-label="breadcrumb">
        <span class="kk-dot"></span>
        <a href={isId ? '/id/' : '/'} class="text-decoration-none">Home</a>
        <span class="mx-1 text-muted-kk">/</span>
        <span class="text-muted-kk">{title}</span>
      </nav>
      <h1 class="display-5 fw-bold mb-3">{heroTitle}</h1>
      <p class="lead text-muted-kk mx-auto mb-0" style="max-width: 600px;">
        {heroSubtitle}
      </p>
    </div>
  </section>

  <!-- Contact Form & Info Section -->
  <section class="kk-section py-5">
    <div class="container">
      <div class="row g-5">
        <!-- Contact Form -->
        <div class="col-lg-7">
          <div class="kk-card p-4 p-md-5">
            <h2 class="h4 font-heading mb-2">
              {isId ? 'Kirim Pesan Kepada Kami' : 'Send Us a Message'}
            </h2>
            <p class="text-muted-kk small mb-4">
              {isId
                ? 'Isi formulir di bawah ini dan kami akan segera merespons Anda.'
                : 'Fill out the form below and our team will get back to you promptly.'}
            </p>

            <form id="contactForm" novalidate>
              <div class="row g-3">
                <div class="col-md-6">
                  <label for="contactName" class="form-label small fw-semibold">
                    {isId ? 'Nama Lengkap' : 'Your Name'} <span class="text-danger">*</span>
                  </label>
                  <input
                    type="text"
                    class="form-control"
                    id="contactName"
                    name="name"
                    placeholder={isId ? 'contoh: Budi Pratama' : 'e.g. John Doe'}
                    required
                  />
                </div>
                <div class="col-md-6">
                  <label for="contactEmail" class="form-label small fw-semibold">
                    {isId ? 'Alamat Email' : 'Email Address'} <span class="text-danger">*</span>
                  </label>
                  <input
                    type="email"
                    class="form-control"
                    id="contactEmail"
                    name="email"
                    placeholder="name@example.com"
                    required
                  />
                </div>
                <div class="col-md-6">
                  <label for="contactPhone" class="form-label small fw-semibold">
                    {isId ? 'Nomor WhatsApp / HP' : 'WhatsApp / Phone'} <span class="text-muted-kk fw-normal">({isId ? 'Opsional' : 'Optional'})</span>
                  </label>
                  <input
                    type="tel"
                    class="form-control"
                    id="contactPhone"
                    name="phone"
                    placeholder={isId ? 'contoh: 08123456789' : 'e.g. +628123456789'}
                  />
                </div>
                <div class="col-md-6">
                  <label for="contactSubject" class="form-label small fw-semibold">
                    {isId ? 'Subjek / Layanan' : 'Subject / Service'} <span class="text-danger">*</span>
                  </label>
                  <input
                    type="text"
                    class="form-control"
                    id="contactSubject"
                    name="subject"
                    placeholder={isId ? 'contoh: Pembuatan Website Perusahaan' : 'e.g. Company Website Development'}
                    required
                  />
                </div>
                <div class="col-12">
                  <label for="contactMessage" class="form-label small fw-semibold">
                    {isId ? 'Pesan / Detail Kebutuhan Proyek' : 'Message / Project Details'} <span class="text-danger">*</span>
                  </label>
                  <textarea
                    class="form-control"
                    id="contactMessage"
                    name="message"
                    rows="5"
                    placeholder={isId
                      ? 'Ceritakan tentang kebutuhan website, perkiraan anggaran, target waktu, atau fitur yang Anda inginkan...'
                      : 'Tell us about your project, timeline, target features, and goals...'}
                    required
                  ></textarea>
                </div>
                <div class="col-12 mt-4 d-flex flex-wrap gap-2 align-items-center">
                  <button type="submit" class="btn btn-primary px-4 py-2 d-inline-flex align-items-center gap-2" id="btnSendWa">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12.001 2c5.523 0 10 4.477 10 10s-4.477 10-10 10a9.95 9.95 0 0 1-5.03-1.355L2.005 22l1.352-4.968A9.95 9.95 0 0 1 2.001 12c0-5.523 4.477-10 10-10M8.593 7.3l-.2.008a1 1 0 0 0-.372.1a1.3 1.3 0 0 0-.294.228c-.12.113-.188.211-.261.306A2.73 2.73 0 0 0 6.9 9.62c.002.49.13.967.33 1.413c.409.902 1.082 1.857 1.97 2.742c.214.213.424.427.65.626a9.45 9.45 0 0 0 3.84 2.046l.568.087c.185.01.37-.004.556-.013a2 2 0 0 0 .833-.231a5 5 0 0 0 .383-.22q.001.002.125-.09c.135-.1.218-.171.33-.288q.126-.13.21-.302c.078-.163.156-.474.188-.733c.024-.198.017-.306.014-.373c-.004-.107-.093-.218-.19-.265l-.582-.261s-.87-.379-1.402-.621a.5.5 0 0 0-.176-.041a.48.48 0 0 0-.378.127c-.005-.002-.072.055-.795.931a.35.35 0 0 1-.368.13a1.4 1.4 0 0 1-.191-.066c-.124-.052-.167-.072-.252-.108a6 6 0 0 1-1.575-1.003c-.126-.11-.243-.23-.363-.346a6.3 6.3 0 0 1-1.02-1.268l-.059-.095a1 1 0 0 1-.102-.205c-.038-.147.061-.265.061-.265s.243-.266.356-.41c.11-.14.203-.276.263-.373c.118-.19.155-.385.093-.536q-.42-1.026-.868-2.041c-.059-.134-.234-.23-.393-.249q-.081-.01-.162-.016a3 3 0 0 0-.403.004z"/>
                    </svg>
                    <span>{isId ? 'Kirim via WhatsApp' : 'Send via WhatsApp'}</span>
                  </button>

                  <button type="button" class="btn btn-outline-kk px-3 py-2 d-inline-flex align-items-center gap-2" id="btnSendEmail">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                      <polyline points="22,6 12,13 2,6"/>
                    </svg>
                    <span>{isId ? 'Kirim via Email' : 'Send via Email'}</span>
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>

        <!-- Contact Info & Content -->
        <div class="col-lg-5">
          <div class="d-flex flex-column gap-4">
            <!-- Direct Contact Card -->
            <div class="kk-card p-4">
              <h3 class="h5 font-heading mb-3">
                {isId ? 'Kontak Langsung' : 'Direct Contact'}
              </h3>
              <p class="text-muted-kk small mb-4">
                {isId
                  ? 'Lebih suka komunikasi langsung? Kami siap berdiskusi cepat.'
                  : "Prefer direct communication? We're responsive and ready to chat."}
              </p>
              <div class="d-flex flex-column gap-3">
                <a
                  href={`https://wa.me/${cleanPhone}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-outline-kk d-flex align-items-center justify-content-center gap-2"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.001 2c5.523 0 10 4.477 10 10s-4.477 10-10 10a9.95 9.95 0 0 1-5.03-1.355L2.005 22l1.352-4.968A9.95 9.95 0 0 1 2.001 12c0-5.523 4.477-10 10-10M8.593 7.3l-.2.008a1 1 0 0 0-.372.1a1.3 1.3 0 0 0-.294.228c-.12.113-.188.211-.261.306A2.73 2.73 0 0 0 6.9 9.62c.002.49.13.967.33 1.413c.409.902 1.082 1.857 1.97 2.742c.214.213.424.427.65.626a9.45 9.45 0 0 0 3.84 2.046l.568.087c.185.01.37-.004.556-.013a2 2 0 0 0 .833-.231a5 5 0 0 0 .383-.22q.001.002.125-.09c.135-.1.218-.171.33-.288q.126-.13.21-.302c.078-.163.156-.474.188-.733c.024-.198.017-.306.014-.373c-.004-.107-.093-.218-.19-.265l-.582-.261s-.87-.379-1.402-.621a.5.5 0 0 0-.176-.041a.48.48 0 0 0-.378.127c-.005-.002-.072.055-.795.931a.35.35 0 0 1-.368.13a1.4 1.4 0 0 1-.191-.066c-.124-.052-.167-.072-.252-.108a6 6 0 0 1-1.575-1.003c-.126-.11-.243-.23-.363-.346a6.3 6.3 0 0 1-1.02-1.268l-.059-.095a1 1 0 0 1-.102-.205c-.038-.147.061-.265.061-.265s.243-.266.356-.41c.11-.14.203-.276.263-.373c.118-.19.155-.385.093-.536q-.42-1.026-.868-2.041c-.059-.134-.234-.23-.393-.249q-.081-.01-.162-.016a3 3 0 0 0-.403.004z"/>
                  </svg>
                  <span>Chat via WhatsApp</span>
                </a>
                <a
                  href={`mailto:${emailForward}`}
                  class="btn btn-outline-kk d-flex align-items-center justify-content-center gap-2"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                  <span>{emailForward}</span>
                </a>
              </div>
            </div>

            <!-- Page Content / Details -->
            {(contentHtml || Astro.slots.has('default')) && (
              <div class="kk-card p-4">
                <div class="article-body">
                  {contentHtml ? (
                    <div set:html={contentHtml} />
                  ) : (
                    <slot />
                  )}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<script is:inline define:vars={{ cleanPhone, emailForward, isId }}>
  (function () {
    function initContactForm() {
      const form = document.getElementById('contactForm');
      const btnEmail = document.getElementById('btnSendEmail');
      if (!form || form._contactBound) return;
      form._contactBound = true;

      function getFormData() {
        const name = (document.getElementById('contactName')?.value || '').trim();
        const email = (document.getElementById('contactEmail')?.value || '').trim();
        const phone = (document.getElementById('contactPhone')?.value || '').trim();
        const subject = (document.getElementById('contactSubject')?.value || '').trim();
        const message = (document.getElementById('contactMessage')?.value || '').trim();
        return { name, email, phone, subject, message };
      }

      function validate() {
        const data = getFormData();
        if (!data.name) {
          alert(isId ? 'Mohon masukkan nama Anda.' : 'Please enter your name.');
          document.getElementById('contactName')?.focus();
          return null;
        }
        if (!data.email) {
          alert(isId ? 'Mohon masukkan alamat email Anda.' : 'Please enter your email address.');
          document.getElementById('contactEmail')?.focus();
          return null;
        }
        if (!data.subject) {
          alert(isId ? 'Mohon masukkan subjek pesan.' : 'Please enter a subject.');
          document.getElementById('contactSubject')?.focus();
          return null;
        }
        if (!data.message) {
          alert(isId ? 'Mohon masukkan detail pesan Anda.' : 'Please enter your message.');
          document.getElementById('contactMessage')?.focus();
          return null;
        }
        return data;
      }

      // WhatsApp Submission
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const data = validate();
        if (!data) return;

        let waText = '';
        if (isId) {
          waText = `*Halo Kukode, saya ingin konsultasi proyek website:*\n\n` +
            `👤 *Nama:* ${data.name}\n` +
            `✉️ *Email:* ${data.email}\n` +
            (data.phone ? `📞 *No HP/WA:* ${data.phone}\n` : '') +
            `📌 *Subjek:* ${data.subject}\n\n` +
            `📝 *Pesan:*\n${data.message}`;
        } else {
          waText = `*Hello Kukode, I would like to inquire about a website project:*\n\n` +
            `👤 *Name:* ${data.name}\n` +
            `✉️ *Email:* ${data.email}\n` +
            (data.phone ? `📞 *Phone/WA:* ${data.phone}\n` : '') +
            `📌 *Subject:* ${data.subject}\n\n` +
            `📝 *Message:*\n${data.message}`;
        }

        const url = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(waText)}`;
        window.open(url, '_blank');
      });

      // Email Submission Fallback
      if (btnEmail) {
        btnEmail.addEventListener('click', function () {
          const data = validate();
          if (!data) return;

          const emailSubject = encodeURIComponent(`[Website Inquiry] ${data.subject}`);
          const emailBody = encodeURIComponent(
            `Name: ${data.name}\n` +
            `Email: ${data.email}\n` +
            (data.phone ? `Phone: ${data.phone}\n` : '') +
            `\nMessage:\n${data.message}`
          );

          window.location.href = `mailto:${emailForward}?subject=${emailSubject}&body=${emailBody}`;
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContactForm);
    } else {
      initContactForm();
    }
    document.addEventListener('astro:page-load', initContactForm);
  })();
</script>
