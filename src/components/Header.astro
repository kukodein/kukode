---
import { getCollection } from 'astro:content';

interface Props {
  alternateUrl?: string;
}

const { alternateUrl } = Astro.props;
const currentPath = Astro.url.pathname;
const currentLocale = Astro.currentLocale || 'en';
const isId = currentLocale === 'id';

// Fetch site settings from CMS
const allSettings = await getCollection('settings');
const siteSettings = allSettings.find(
  (s) => s.id === (isId ? 'id/general' : 'en/general') || s.id.startsWith(isId ? 'id' : 'en')
)?.data;

const logoLight = siteSettings?.logo_light || '/image/Logo-Kukode-Landscape.png';
const logoDark = siteSettings?.logo_dark || '/image/Logo-Kukode-Landscape-White.png';

// Language toggle
let langTogglePath = alternateUrl;
if (!langTogglePath) {
  if (isId) {
    langTogglePath = currentPath.replace(/^\/id(\/|$)/, '$1') || '/';
  } else {
    langTogglePath = `/id${currentPath.endsWith('/') ? currentPath : currentPath + '/'}`;
  }
} else {
  // Normalize alternateUrl to root-relative path so navigation stays on current host
  try {
    const parsed = new URL(langTogglePath, Astro.url);
    langTogglePath = parsed.pathname + parsed.search + parsed.hash;
  } catch {
    // Keep as is if URL parsing fails
  }
}
const langFlag = isId ? '🇬🇧' : '🇮🇩';
const langTitle = isId ? 'Switch to English' : 'Ganti ke Bahasa Indonesia';

// Navigation items
const prefix = isId ? '/id' : '';
const defaultNav = [
  { label: isId ? 'Layanan' : 'Services', url: `${prefix}/#services` },
  { label: isId ? 'Proses' : 'Process', url: `${prefix}/#process` },
  { label: isId ? 'Portofolio' : 'Portfolio', url: '/portfolio/' },
  { label: isId ? 'Harga' : 'Pricing', url: `${prefix}/#pricing` },
  { label: 'Blog', url: `${prefix}/article/` },
  { label: 'FAQ', url: `${prefix}/#faq` },
];

const navItems =
  siteSettings?.header_nav && siteSettings.header_nav.length > 0
    ? siteSettings.header_nav
    : defaultNav;

const ctaText = siteSettings?.header_cta_text || (isId ? 'Hubungi Kami' : 'Get a Quote');
const ctaUrl = siteSettings?.header_cta_url || `${prefix}/#contact`;
---

<header class="kk-navbar-wrap px-2">
  <nav class="navbar navbar-expand-lg kk-navbar container p-1 p-lg-2">
    <div class="container-fluid px-2">
      <a class="navbar-brand d-flex align-items-center gap-2" href={isId ? '/id/' : '/'}>
        <img src={logoLight} class="d-show-light d-none-dark" alt="Kukode" style="min-width: 32px" height="32px" width="101px" loading="lazy" />
        <img src={logoDark} class="d-show-dark d-none-light" alt="Kukode" style="min-width: 32px" height="32px" width="96px" loading="lazy" />
      </a>

      <div class="d-flex d-lg-none gap-2">
        <a href={langTogglePath} class="kk-lang-toggle text-decoration-none" title={langTitle} data-astro-reload>{langFlag}</a>
        <button class="kk-theme-toggle ms-lg-1" id="themeToggleMobile" aria-label="Toggle dark mode">
          <svg class="kk-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          <svg class="kk-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
        </button>
        <button class="navbar-toggler border-0 btn p-1" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="navbar-toggler">
          <span class="navbar-toggler-icon" style="width:1.2em;height:1.2em;"></span>
        </button>
      </div>

      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1 my-2 my-lg-0">
          {navItems.map((item) => (
            <li class="nav-item">
              <a class="nav-link" href={item.url}>{item.label}</a>
            </li>
          ))}
          <li class="nav-item ms-lg-2 mt-2 my-lg-0">
            <a class="btn btn-primary btn-sm" href={ctaUrl}>{ctaText}</a>
          </li>
          <li class="nav-item kk-lang-slot ms-lg-2 border-top border-lg-0 pt-3 pt-lg-0 justify-content-between d-none d-lg-flex">
            <a href={langTogglePath} class="kk-lang-toggle text-decoration-none" title={langTitle} data-astro-reload>{langFlag}</a>
            <button class="kk-theme-toggle ms-lg-1" id="themeToggle" aria-label="Toggle dark mode">
              <svg class="kk-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
              <svg class="kk-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>
