---
import { getCollection } from 'astro:content';

const currentLocale = Astro.currentLocale || 'en';
const isId = currentLocale === 'id';

// Fetch site settings from CMS
const allSettings = await getCollection('settings');
const siteSettings =
  allSettings.find(
    (s) => s.id === (isId ? 'id/general' : 'en/general') || s.id === (isId ? 'id/general.json' : 'en/general.json')
  )?.data ||
  allSettings.find(
    (s) => s.id === 'general' || s.id === 'general.json'
  )?.data;

const rawPhone = siteSettings?.whatsapp || '62853293353541';
const cleanPhone = rawPhone.replace(/\D/g, '');

const greeting = isId
  ? 'Halo! Butuh website atau konsultasi proyek? Chat dengan kami 👋'
  : 'Hi there! Need a website or project consultation? Chat with us 👋';

const defaultMessage = isId
  ? 'Halo Kukode, saya ingin konsultasi mengenai pembuatan website.'
  : 'Hello Kukode, I would like to inquire about website development services.';

const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(defaultMessage)}`;
---

<div class="kk-whatsapp-float" id="kkWhatsAppFloat" aria-live="polite">
  <!-- Greeting Bubble -->
  <div class="kk-whatsapp-bubble" id="kkWaBubble">
    <span>{greeting}</span>
    <button type="button" class="kk-whatsapp-bubble-close" id="kkWaBubbleClose" aria-label="Close message">
      &times;
    </button>
  </div>

  <!-- WhatsApp Action Button -->
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="kk-whatsapp-btn"
    aria-label="Chat on WhatsApp"
    title="Chat on WhatsApp"
  >
    <span class="kk-whatsapp-pulse"></span>
    <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12.001 2c5.523 0 10 4.477 10 10s-4.477 10-10 10a9.95 9.95 0 0 1-5.03-1.355L2.005 22l1.352-4.968A9.95 9.95 0 0 1 2.001 12c0-5.523 4.477-10 10-10M8.593 7.3l-.2.008a1 1 0 0 0-.372.1a1.3 1.3 0 0 0-.294.228c-.12.113-.188.211-.261.306A2.73 2.73 0 0 0 6.9 9.62c.002.49.13.967.33 1.413c.409.902 1.082 1.857 1.97 2.742c.214.213.424.427.65.626a9.45 9.45 0 0 0 3.84 2.046l.568.087c.185.01.37-.004.556-.013a2 2 0 0 0 .833-.231a5 5 0 0 0 .383-.22q.001.002.125-.09c.135-.1.218-.171.33-.288q.126-.13.21-.302c.078-.163.156-.474.188-.733c.024-.198.017-.306.014-.373c-.004-.107-.093-.218-.19-.265l-.582-.261s-.87-.379-1.402-.621a.5.5 0 0 0-.176-.041a.48.48 0 0 0-.378.127c-.005-.002-.072.055-.795.931a.35.35 0 0 1-.368.13a1.4 1.4 0 0 1-.191-.066c-.124-.052-.167-.072-.252-.108a6 6 0 0 1-1.575-1.003c-.126-.11-.243-.23-.363-.346a6.3 6.3 0 0 1-1.02-1.268l-.059-.095a1 1 0 0 1-.102-.205c-.038-.147.061-.265.061-.265s.243-.266.356-.41c.11-.14.203-.276.263-.373c.118-.19.155-.385.093-.536q-.42-1.026-.868-2.041c-.059-.134-.234-.23-.393-.249q-.081-.01-.162-.016a3 3 0 0 0-.403.004z"/>
    </svg>
  </a>
</div>

<script is:inline>
  (function () {
    function initWaWidget() {
      const bubble = document.getElementById('kkWaBubble');
      const closeBtn = document.getElementById('kkWaBubbleClose');
      if (!bubble) return;

      if (sessionStorage.getItem('kk-wa-dismissed') === '1') {
        bubble.style.display = 'none';
      }

      if (closeBtn && !closeBtn._waBound) {
        closeBtn._waBound = true;
        closeBtn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          bubble.style.display = 'none';
          sessionStorage.setItem('kk-wa-dismissed', '1');
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWaWidget);
    } else {
      initWaWidget();
    }
    document.addEventListener('astro:page-load', initWaWidget);
  })();
</script>

