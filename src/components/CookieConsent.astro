---
const currentLocale = Astro.currentLocale || 'en';
const isId = currentLocale === 'id';

const message = isId
  ? 'Website ini menggunakan cookie untuk memastikan Anda mendapatkan pengalaman terbaik saat menjelajahi situs kami. Pelajari selengkapnya di'
  : 'This website uses cookies to ensure you get the best browsing experience on our website. Learn more in our';

const privacyText = isId ? 'Kebijakan Privasi' : 'Privacy Policy';
const privacyLink = isId ? '/id/kebijakan-privasi/' : '/privacy-policy/';

const acceptText = isId ? 'Setuju' : 'Accept';
const declineText = isId ? 'Tutup' : 'Decline';
---

<div class="kk-cookie-consent" id="kkCookieConsent" role="region" aria-label="Cookie consent banner">
  <div class="container">
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
      <div class="d-flex align-items-center gap-2">
        <span class="fs-4" aria-hidden="true">🍪</span>
        <p class="small mb-0 text-muted-kk">
          {message} <a href={privacyLink}>{privacyText}</a>.
        </p>
      </div>

      <div class="d-flex align-items-center gap-2 ms-auto flex-shrink-0">
        <button type="button" class="btn btn-outline-kk btn-sm px-3" id="kkCookieDecline">
          {declineText}
        </button>
        <button type="button" class="btn btn-primary btn-sm px-3" id="kkCookieAccept">
          {acceptText}
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    function initCookieConsent() {
      const banner = document.getElementById('kkCookieConsent');
      const btnAccept = document.getElementById('kkCookieAccept');
      const btnDecline = document.getElementById('kkCookieDecline');
      if (!banner) return;

      const consent = localStorage.getItem('kk-cookie-consent');
      if (consent) {
        banner.classList.remove('show');
        return;
      }

      // Show banner after brief delay
      setTimeout(function () {
        if (!localStorage.getItem('kk-cookie-consent')) {
          banner.classList.add('show');
        }
      }, 700);

      if (btnAccept && !btnAccept._cookieBound) {
        btnAccept._cookieBound = true;
        btnAccept.addEventListener('click', function () {
          localStorage.setItem('kk-cookie-consent', 'accepted');
          banner.classList.remove('show');
        });
      }

      if (btnDecline && !btnDecline._cookieBound) {
        btnDecline._cookieBound = true;
        btnDecline.addEventListener('click', function () {
          localStorage.setItem('kk-cookie-consent', 'declined');
          banner.classList.remove('show');
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCookieConsent);
    } else {
      initCookieConsent();
    }
    document.addEventListener('astro:page-load', initCookieConsent);
  })();
</script>

