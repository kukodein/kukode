---
import { getCollection } from 'astro:content';

const currentLocale = Astro.currentLocale || 'en';
const isId = currentLocale === 'id';
const prefix = isId ? '/id' : '';
const currentYear = new Date().getFullYear();

// Fetch site settings from CMS
const allSettings = await getCollection('settings');
const siteSettings =
  allSettings.find(
    (s) => s.id === (isId ? 'id/general' : 'en/general') || s.id === (isId ? 'id/general.json' : 'en/general.json')
  )?.data ||
  allSettings.find(
    (s) => s.id === 'general' || s.id === 'general.json'
  )?.data;

const logoLight = siteSettings?.logo_light || '/image/Logo-Kukode-Landscape.png';
const logoDark = siteSettings?.logo_dark || '/image/Logo-Kukode-Landscape-White.png';

const description =
  siteSettings?.footer_description ||
  (isId
    ? 'Studio pengembangan web yang membantu bisnis membangun website modern dan cepat.'
    : 'Web development studio helping growing businesses build fast, modern websites.');

const addressTitle = siteSettings?.footer_address_title || (isId ? 'Kantor Pusat' : 'Head Quarter');
const address = siteSettings?.footer_address || 'Yogyakarta, Indonesia';

// 3 Columns default fallbacks
const defaultCol1 = {
  title: isId ? 'Navigasi' : 'Navigation',
  items: [
    { label: isId ? 'Layanan' : 'Services', url: `${prefix}/#services` },
    { label: isId ? 'Portofolio' : 'Portfolio', url: '/portfolio/' },
    { label: isId ? 'Harga' : 'Pricing', url: `${prefix}/#pricing` },
    { label: isId ? 'Tentang' : 'About', url: isId ? '/id/tentang/' : '/about/' },
  ],
};

const defaultCol2 = {
  title: isId ? 'Sosial' : 'Social',
  items: [
    { label: 'Instagram', url: 'https://www.instagram.com/kukode.id' },
    { label: 'LinkedIn', url: 'https://www.linkedin.com/company/kukode' },
    { label: 'YouTube', url: 'https://www.youtube.com/@kukode_id' },
  ],
};

const defaultCol3 = {
  title: isId ? 'Kontak' : 'Contact',
  items: [
    { label: 'WhatsApp', url: 'https://wa.me/62853293353541' },
    { label: isId ? 'Konsultasi' : 'Get a Quote', url: `${prefix}/#contact` },
  ],
};

const col1 = (siteSettings?.footer_col_1?.items && siteSettings.footer_col_1.items.length > 0) ? siteSettings.footer_col_1 : defaultCol1;
const col2 = (siteSettings?.footer_col_2?.items && siteSettings.footer_col_2.items.length > 0) ? siteSettings.footer_col_2 : defaultCol2;
const col3 = (siteSettings?.footer_col_3?.items && siteSettings.footer_col_3.items.length > 0) ? siteSettings.footer_col_3 : defaultCol3;

const defaultSocial = {
  instagram: 'https://www.instagram.com/kukode.id',
  facebook: 'https://www.facebook.com/kukodein',
  youtube: 'https://www.youtube.com/@kukode_id',
  whatsapp: 'https://wa.me/62853293353541',
  linkedin: 'https://www.linkedin.com/company/kukode',
};
const social = siteSettings?.social_media || defaultSocial;
const copyrightText =
  siteSettings?.copyright_text ||
  (isId
    ? 'Kukode Digital Technology · Semua hak dilindungi.'
    : 'Kukode Digital Technology · All rights reserved.');
---

<footer class="kk-section kk-gradient-alt pb-4" style="border-top:1px solid var(--bs-border-color);">
  <div class="container">
    <div class="row g-4">
      <!-- Main Brand & Description -->
      <div class="col-12 col-md">
        <img class="mb-3 d-show-light d-none-dark" width="126" height="40" src={logoLight} alt="Kukode" loading="lazy" />
        <img class="mb-3 d-show-dark d-none-light" width="120" height="40" src={logoDark} alt="Kukode" loading="lazy" />
        <p class="text-muted-kk small">{description}</p>
        {address && (
          <p class="text-muted-kk small">
            <strong>{addressTitle}</strong><br />
            {address}
          </p>
        )}

        <!-- Social Media Icons (rendered if filled) -->
        <div class="d-flex gap-2 mt-3 flex-wrap">
          {social.instagram && (
            <a class="kk-icon-circle kk-icon-circle-small link-primary" target="_blank" aria-label="Instagram" href={social.instagram} rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          )}
          {social.facebook && (
            <a class="kk-icon-circle kk-icon-circle-small link-primary" target="_blank" aria-label="Facebook" href={social.facebook} rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M12.001 2c-5.523 0-10 4.477-10 10c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89c1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.344 21.129 22 16.992 22 12c0-5.523-4.477-10-10-10"></path></svg>
            </a>
          )}
          {social.youtube && (
            <a class="kk-icon-circle kk-icon-circle-small link-primary" target="_blank" aria-label="YouTube" href={social.youtube} rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M12.244 4c.534.003 1.87.016 3.29.073l.504.022c1.429.067 2.857.183 3.566.38c.945.266 1.687 1.04 1.938 2.022c.4 1.56.45 4.602.456 5.339l.001.152v.174c-.007.737-.057 3.78-.457 5.339c-.254.985-.997 1.76-1.938 2.022c-.709.197-2.137.313-3.566.38l-.504.023c-1.42.056-2.756.07-3.29.072l-.235.001h-.255c-1.13-.007-5.856-.058-7.36-.476c-.944-.266-1.687-1.04-1.938-2.022c-.4-1.56-.45-4.602-.456-5.339v-.326c.006-.737.056-3.78.456-5.339c.254-.985.997-1.76 1.939-2.021c1.503-.419 6.23-.47 7.36-.476zM9.999 8.5v7l6-3.5z"></path></svg>
            </a>
          )}
          {social.whatsapp && (
            <a class="kk-icon-circle kk-icon-circle-small link-primary" target="_blank" aria-label="WhatsApp" href={social.whatsapp} rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M12.001 2c5.523 0 10 4.477 10 10s-4.477 10-10 10a9.95 9.95 0 0 1-5.03-1.355L2.005 22l1.352-4.968A9.95 9.95 0 0 1 2.001 12c0-5.523 4.477-10 10-10M8.593 7.3l-.2.008a1 1 0 0 0-.372.1a1.3 1.3 0 0 0-.294.228c-.12.113-.188.211-.261.306A2.73 2.73 0 0 0 6.9 9.62c.002.49.13.967.33 1.413c.409.902 1.082 1.857 1.97 2.742c.214.213.424.427.65.626a9.45 9.45 0 0 0 3.84 2.046l.568.087c.185.01.37-.004.556-.013a2 2 0 0 0 .833-.231a5 5 0 0 0 .383-.22q.001.002.125-.09c.135-.1.218-.171.33-.288q.126-.13.21-.302c.078-.163.156-.474.188-.733c.024-.198.017-.306.014-.373c-.004-.107-.093-.218-.19-.265l-.582-.261s-.87-.379-1.402-.621a.5.5 0 0 0-.176-.041a.48.48 0 0 0-.378.127c-.005-.002-.072.055-.795.931a.35.35 0 0 1-.368.13a1.4 1.4 0 0 1-.191-.066c-.124-.052-.167-.072-.252-.108a6 6 0 0 1-1.575-1.003c-.126-.11-.243-.23-.363-.346a6.3 6.3 0 0 1-1.02-1.268l-.059-.095a1 1 0 0 1-.102-.205c-.038-.147.061-.265.061-.265s.243-.266.356-.41c.11-.14.203-.276.263-.373c.118-.19.155-.385.093-.536q-.42-1.026-.868-2.041c-.059-.134-.234-.23-.393-.249q-.081-.01-.162-.016a3 3 0 0 0-.403.004z"></path></svg>
            </a>
          )}
          {social.linkedin && (
            <a class="kk-icon-circle kk-icon-circle-small link-primary" target="_blank" aria-label="LinkedIn" href={social.linkedin} rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68zm1.39 9.94v-8.37H5.5v8.37z"/></svg>
            </a>
          )}
        </div>
      </div>

      <!-- Column 1 -->
      <div class="col-6 col-md-2 offset-md-1">
        <p class="fw-bold small mb-3">{col1.title}</p>
        <ul class="list-unstyled small">
          {col1.items && col1.items.map((item) => (
            <li class="mb-2">
              <a href={item.url} class="text-muted-kk text-decoration-none">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 2 -->
      <div class="col-6 col-md-2">
        <p class="fw-bold small mb-3">{col2.title}</p>
        <ul class="list-unstyled small">
          {col2.items && col2.items.map((item) => (
            <li class="mb-2">
              <a href={item.url} class="text-muted-kk text-decoration-none" target={item.url.startsWith('http') ? '_blank' : undefined} rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3 -->
      <div class="col-6 col-md-2">
        <p class="fw-bold small mb-3">{col3.title}</p>
        <ul class="list-unstyled small">
          {col3.items && col3.items.map((item) => (
            <li class="mb-2">
              <a href={item.url} class="text-muted-kk text-decoration-none" target={item.url.startsWith('http') ? '_blank' : undefined} rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-divider">
      <img src="/image/kukode-logo-transparent.png" width="20" height="20" alt="Separator Image" loading="lazy" />
    </div>

    <!-- Copyright with dynamic year -->
    <div class="text-center text-muted-kk small">
      &copy; {currentYear} {copyrightText}
    </div>
  </div>
</footer>
