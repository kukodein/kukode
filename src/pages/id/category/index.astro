---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const site = Astro.site?.toString().replace(/\/$/, '') || 'https://kukode.com';

// Fetch archive settings
const allSettings = await getCollection('settings');
const archiveSettings = allSettings.find(
  (s) => s.id === 'id/archives' || s.id === 'id/archives.json'
)?.data?.categories;

const title = archiveSettings?.seo_title || 'Daftar Kategori | Kukode';
const description =
  archiveSettings?.seo_description ||
  'Jelajahi artikel dan panduan berdasarkan kategori topik di Kukode.';
const seoImage = archiveSettings?.seo_image || '/image/default-thumbnail.jpg';
const headerTitle = archiveSettings?.header_title || 'Jelajahi Berdasarkan Kategori';
const headerDesc =
  archiveSettings?.header_description ||
  'Temukan artikel, tutorial, dan panduan yang dikelompokkan berdasarkan topik untuk mendukung bisnis digital Anda.';

// Fetch Indonesian categories
const categories = await getCollection('categories', ({ id }) =>
  id.startsWith('id/')
);

// Fetch published Indonesian posts to count articles per category
const posts = await getCollection(
  'posts',
  ({ id, data }) => id.startsWith('id/') && !data.draft
);

const categoriesWithCount = categories.map((cat) => {
  const catName = cat.data.name;
  const count = posts.filter(
    (p) => p.data.category?.toLowerCase() === catName.toLowerCase()
  ).length;
  const slug =
    cat.data.custom_slug ||
    cat.data.slug_id ||
    cat.id.replace(/^id\//, '').replace(/\.(md|json)$/, '');
  return {
    ...cat,
    count,
    slug,
  };
});

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: `${site}/id/` },
    { '@type': 'ListItem', position: 2, name: 'Kategori', item: `${site}/id/category/` },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={seoImage}
  alternateEn={`${site}/category/`}
  alternateId={`${site}/id/category/`}
  headerAlternateUrl="/category/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main class="kk-template-page">
    <div class="container py-5">
      <!-- Breadcrumbs -->
      <nav class="kk-breadcrumb-nav mb-4">
        <a href="/id/" class="text-decoration-none text-muted-kk">Beranda</a>
        <span class="mx-1 text-muted-kk">/</span>
        <span class="text-muted-kk">Kategori</span>
      </nav>

      <!-- Header -->
      <div class="text-center mb-5">
        <p class="kk-eyebrow mb-2">Kategori</p>
        <h1 class="display-5 font-heading fw-bold mb-3">{headerTitle}</h1>
        <p class="text-muted-kk mx-auto fs-5" style="max-width: 640px;">
          {headerDesc}
        </p>
      </div>

      <!-- Categories Grid -->
      <div class="row g-4 mb-5">
        {categoriesWithCount.map((cat) => (
          <div class="col-md-6 col-lg-4">
            <div class="kk-card p-4 h-100 bg-surface border d-flex flex-column justify-content-between">
              <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <span class="badge text-bg-primary fw-normal">
                    {cat.count} Artikel
                  </span>
                  <span class="text-muted-kk small">Topik</span>
                </div>
                <h2 class="h4 font-heading fw-bold mb-2">
                  <a href={`/id/category/${cat.slug}/`} class="text-decoration-none text-reset">
                    {cat.data.name}
                  </a>
                </h2>
                {cat.data.description && (
                  <p class="text-muted-kk small mb-4">{cat.data.description}</p>
                )}
              </div>
              <div class="pt-3 border-top mt-auto">
                <a
                  href={`/id/category/${cat.slug}/`}
                  class="btn btn-outline-kk btn-sm w-100 d-flex justify-content-between align-items-center"
                >
                  <span>Lihat Artikel</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      {categoriesWithCount.length === 0 && (
        <div class="text-center py-5">
          <p class="text-muted-kk">Belum ada kategori yang tersedia saat ini.</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>

