---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const site = Astro.site?.toString().replace(/\/$/, '') || 'https://kukode.com';

const allPosts = await getCollection('posts', ({ id, data }) =>
  id.startsWith('id/') && !data.draft
);
const posts = allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const title = 'Artikel & Berita | Kukode';
const description = 'Baca artikel terbaru tentang pengembangan web, bisnis, dan teknologi dari Kukode.';
---

<BaseLayout
  title={title}
  description={description}
  alternateEn={`${site}/article/`}
  alternateId={`${site}/id/article/`}
>
  <main class="kk-template-page">
    <div class="container py-5">
      <div class="text-center mb-5">
        <p class="kk-eyebrow mb-3">Artikel & Berita</p>
        <h1>Apa yang bisa Kami bantu untuk bisnis Anda?</h1>
        <p class="text-muted-kk">Wawasan, tutorial, dan berita dari dunia pengembangan web dan bisnis digital.</p>
      </div>

      <div class="d-flex justify-content-center gap-2 mb-4 flex-wrap">
        <a href="/id/article/" class="btn px-3 py-1 btn-primary">Semua</a>
        <a href="/id/category/information/" class="btn px-3 py-1 btn-outline-kk">Informasi</a>
        <a href="/id/category/website/" class="btn px-3 py-1 btn-outline-kk">Website</a>
        <a href="/id/category/tutorial/" class="btn px-3 py-1 btn-outline-kk">Tutorial</a>
      </div>

      <div class="row g-3">
        {posts.map(post => {
          const slug = post.data.custom_slug || post.id.replace(/^id\//, '');
          return (
            <div class="col-6 col-md-4">
              <div class="kk-card p-2">
                <a href={`/id/article/${slug}`} class="text-decoration-none text-reset">
                  {post.data.image && (
                    <img src={post.data.image} alt={post.data.title} class="img-fluid rounded-3 w-100 aspect-ratio-16-9 bg-light" style="min-height:100px;" loading="lazy" />
                  )}
                  <div class="m-2">
                    <div id="meta-post" class="d-flex justify-content-between mt-3">
                      <span class="text-muted-kk small text-uppercase">{post.data.category}</span>
                      <time datetime={post.data.pubDate.toISOString().split('T')[0]} class="text-muted-kk small mb-1 d-block">{post.data.pubDate.toISOString().split('T')[0]}</time>
                    </div>
                    <h3 class="h6 font-heading mt-2">{post.data.title}</h3>
                    {post.data.description && <p class="text-muted-kk small">{post.data.description}</p>}
                  </div>
                </a>
              </div>
            </div>
          );
        })}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-5">
          <p class="text-muted-kk">Belum ada artikel. Nantikan segera!</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
