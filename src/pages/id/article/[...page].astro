---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../../utils/date';

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection('posts', ({ id, data }) =>
    id.startsWith('id/') && !data.draft
  );
  const posts = allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

  return paginate(posts, { pageSize: 12 });
}

const { page } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://kukode.com';

// Fetch archive settings
const allSettings = await getCollection('settings');
const archiveSettings = allSettings.find(
  (s) => s.id === 'id/archives' || s.id === 'id/archives.json'
)?.data?.articles;

// Fetch all published Indonesian posts for the client-side search index
const allIdPosts = (await getCollection('posts', ({ id, data }) =>
  id.startsWith('id/') && !data.draft
)).sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const searchIndex = allIdPosts.map((p) => ({
  title: p.data.title,
  slug: p.data.custom_slug || p.id.replace(/^id\//, ''),
  description: p.data.description || '',
  category: p.data.category || 'Informasi',
  pubDate: formatDate(p.data.pubDate, 'id'),
  pubDateIso: p.data.pubDate.toISOString().split('T')[0],
  image: p.data.image || '/image/default-thumbnail.jpg',
}));

const baseTitle = archiveSettings?.seo?.title || archiveSettings?.seo_title || 'Artikel & Berita | Kukode';
const title = page.currentPage > 1 ? `${baseTitle.replace(/ \| Kukode$/, '')} - Halaman ${page.currentPage} | Kukode` : baseTitle;
const description =
  archiveSettings?.seo?.description ||
  archiveSettings?.seo_description ||
  'Baca artikel terbaru tentang pengembangan web, bisnis, dan teknologi dari Kukode.';
const seoImage = archiveSettings?.seo?.image || archiveSettings?.seo_image || '/image/default-thumbnail.jpg';
const headerTitle = archiveSettings?.header_title || 'Apa yang bisa Kami bantu untuk bisnis Anda?';
const headerDesc =
  archiveSettings?.header_description ||
  'Wawasan, tutorial, dan berita dari dunia pengembangan web dan bisnis digital.';

const currentUrl = page.currentPage === 1 ? `${site}/id/article/` : `${site}/id/article/${page.currentPage}/`;
const alternateEn = page.currentPage === 1 ? `${site}/article/` : `${site}/article/${page.currentPage}/`;
---

<BaseLayout
  title={title}
  description={description}
  image={seoImage}
  canonical={currentUrl}
  alternateEn={alternateEn}
  alternateId={currentUrl}
  headerAlternateUrl={page.currentPage === 1 ? '/article/' : `/article/${page.currentPage}/`}
>
  <main class="kk-template-page">
    <div class="container py-5">
      <div class="text-center mb-5">
        <!-- Breadcrumbs -->
        <nav class="kk-badge-pill kk-breadcrumb-nav mb-2" aria-label="breadcrumb">
          <span class="kk-dot"></span>
          <a href="/id/" class="text-decoration-none">Beranda</a>
          <span class="mx-1 text-muted-kk">/</span>
          <span class="text-muted-kk">Artikel & Berita</span>
          {page.currentPage > 1 && (
            <>
              <span class="mx-1 text-muted-kk">/</span>
              <span class="text-muted-kk">Halaman {page.currentPage}</span>
            </>
          )}
        </nav>
        <h1 class="mb-3">{headerTitle}</h1>
        <p class="text-muted-kk mx-auto" style="max-width: 580px;">{headerDesc}</p>
      </div>

      <div class="d-flex mb-4 justify-content-between align-items-center">
        <!-- Category Filter Buttons -->
        <div class="d-flex gap-2" id="category-filters">
          <a href="/id/article/" class="btn px-3 py-1 btn-primary">Semua</a>
          <a href="/id/category/information/" class="btn px-3 py-1 btn-outline-kk">Informasi</a>
          <a href="/id/category/website/" class="btn px-3 py-1 btn-outline-kk">Website</a>
          <a href="/id/category/tutorial/" class="btn px-3 py-1 btn-outline-kk">Tutorial</a>
        </div>

        <!-- Live Search Input -->
        <div class="position-relative">
          <svg class="kk-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input
            type="search"
            id="articleSearchInput"
            class="form-control kk-search-input"
            placeholder="Cari artikel..."
            autocomplete="off"
            aria-label="Cari artikel"
          />
          <button type="button" id="articleSearchClear" class="kk-search-clear d-none" aria-label="Hapus pencarian">&times;</button>
        </div>
      </div>

      <h2 class="visually-hidden">Daftar Artikel</h2>

      <!-- Search Results Container (Hidden by default) -->
      <div id="search-results-wrap" class="d-none">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <p id="search-feedback" class="text-muted-kk mb-0 small fw-semibold"></p>
        </div>
        <div class="row g-3" id="search-results-grid"></div>
        <div id="search-empty" class="text-center py-5 d-none">
          <p class="text-muted-kk fs-5 mb-1">Tidak ada artikel yang cocok dengan pencarian Anda.</p>
          <p class="text-muted-kk small">Coba cari dengan kata kunci lain.</p>
        </div>
      </div>

      <!-- Paginated Default Container -->
      <div id="paginated-posts-wrap">
        <div class="row g-3">
          {page.data.map((post) => {
            const slug = post.data.custom_slug || post.id.replace(/^id\//, '');
            return (
              <div class="col-6 col-md-4">
                <div class="kk-card p-2 h-100 d-flex flex-column">
                  <a href={`/id/article/${slug}/`} class="text-decoration-none text-reset flex-grow-1">
                    {post.data.image && (
                      <img src={post.data.image} alt={post.data.title} class="img-fluid rounded-3 w-100 aspect-ratio-16-9 bg-light" style="min-height:100px; object-fit: cover;" loading="lazy" decoding="async" />
                    )}
                    <div class="m-2">
                      <div id="meta-post" class="d-flex justify-content-between mt-3">
                        <span class="text-muted-kk small text-uppercase">{post.data.category}</span>
                        <time datetime={post.data.pubDate.toISOString().split('T')[0]} class="text-muted-kk small mb-1 d-block">{formatDate(post.data.pubDate, 'id')}</time>
                      </div>
                      <h3 class="h6 font-heading mt-2">{post.data.title}</h3>
                      {post.data.description && <p class="text-muted-kk small line-clamp-2">{post.data.description}</p>}
                    </div>
                  </a>
                </div>
              </div>
            );
          })}
        </div>

        {page.data.length === 0 && (
          <div class="text-center py-5">
            <p class="text-muted-kk">Belum ada artikel. Nantikan segera!</p>
          </div>
        )}

        <!-- Pagination Component -->
        <Pagination page={page} />
      </div>
    </div>
  </main>

  <!-- Embed Search Index JSON -->
  <script id="all-posts-data" type="application/json" set:html={JSON.stringify(searchIndex)} />

  <!-- Client-Side Search Script -->
  <script is:inline>
    (function () {
      function initArticleSearch() {
        const input = document.getElementById('articleSearchInput');
        const clearBtn = document.getElementById('articleSearchClear');
        const searchWrap = document.getElementById('search-results-wrap');
        const paginatedWrap = document.getElementById('paginated-posts-wrap');
        const resultsGrid = document.getElementById('search-results-grid');
        const feedback = document.getElementById('search-feedback');
        const emptyState = document.getElementById('search-empty');
        const dataEl = document.getElementById('all-posts-data');

        if (!input || !dataEl || !searchWrap || !paginatedWrap || !resultsGrid) return;

        let posts = [];
        try {
          posts = JSON.parse(dataEl.textContent || '[]');
        } catch {
          posts = [];
        }

        function escapeHtml(text) {
          const div = document.createElement('div');
          div.textContent = text;
          return div.innerHTML;
        }

        function handleSearch() {
          const q = (input.value || '').trim().toLowerCase();

          if (!q) {
            clearBtn.classList.add('d-none');
            searchWrap.classList.add('d-none');
            paginatedWrap.classList.remove('d-none');
            resultsGrid.innerHTML = '';
            return;
          }

          clearBtn.classList.remove('d-none');
          paginatedWrap.classList.add('d-none');
          searchWrap.classList.remove('d-none');

          const matched = posts.filter(
            (p) =>
              (p.title || '').toLowerCase().includes(q) ||
              (p.description || '').toLowerCase().includes(q) ||
              (p.category || '').toLowerCase().includes(q)
          );

          if (matched.length === 0) {
            resultsGrid.innerHTML = '';
            feedback.textContent = `0 artikel ditemukan untuk "${input.value.trim()}"`;
            emptyState.classList.remove('d-none');
          } else {
            emptyState.classList.add('d-none');
            feedback.textContent = `Ditemukan ${matched.length} artikel untuk "${input.value.trim()}"`;

            resultsGrid.innerHTML = matched
              .map(
                (p) => `
              <div class="col-6 col-md-4">
                <div class="kk-card p-2 h-100 d-flex flex-column">
                  <a href="/id/article/${encodeURIComponent(p.slug)}/" class="text-decoration-none text-reset flex-grow-1">
                    <img src="${escapeHtml(p.image)}" alt="${escapeHtml(p.title)}" class="img-fluid rounded-3 w-100 aspect-ratio-16-9 bg-light" style="min-height:100px; object-fit: cover;" loading="lazy" decoding="async" />
                    <div class="m-2">
                      <div id="meta-post" class="d-flex justify-content-between mt-3">
                        <span class="text-muted-kk small text-uppercase">${escapeHtml(p.category)}</span>
                        <time datetime="${escapeHtml(p.pubDateIso || p.pubDate)}" class="text-muted-kk small mb-1 d-block">${escapeHtml(p.pubDate)}</time>
                      </div>
                      <h3 class="h6 font-heading mt-2">${escapeHtml(p.title)}</h3>
                      ${p.description ? `<p class="text-muted-kk small line-clamp-2">${escapeHtml(p.description)}</p>` : ''}
                    </div>
                  </a>
                </div>
              </div>
            `
              )
              .join('');
          }
        }

        input.addEventListener('input', handleSearch);

        clearBtn.addEventListener('click', () => {
          input.value = '';
          handleSearch();
          input.focus();
        });
      }

      document.addEventListener('DOMContentLoaded', initArticleSearch);
      document.addEventListener('astro:page-load', initArticleSearch);
    })();
  </script>
</BaseLayout>
