---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SocialShare from '../../../components/SocialShare.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ id, data }) =>
    id.startsWith('id/') && !data.draft
  );

  return posts.map((post) => ({
    params: { slug: post.data.custom_slug || post.id.replace(/^id\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const site = Astro.site?.toString().replace(/\/$/, '') || 'https://kukode.com';
const slug = post.data.custom_slug || post.id.replace(/^id\//, '');
const canonicalUrl = `${site}/id/article/${slug}/`;
const pubDateStr = post.data.pubDate.toISOString().split('T')[0];
const updatedDateStr = post.data.updatedDate ? post.data.updatedDate.toISOString().split('T')[0] : null;
const showUpdated = updatedDateStr && updatedDateStr !== pubDateStr;

// Calculate reading time
const wordCount = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Check for English counterpart (by translation_key or by base filename)
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const enCounterpart = allPosts.find((p) => {
  if (!p.id.startsWith('en/')) return false;
  if (post.data.translation_key && p.data.translation_key) {
    return p.data.translation_key === post.data.translation_key;
  }
  return p.id === post.id.replace(/^id\//, 'en/');
});

const enSlug = enCounterpart ? (enCounterpart.data.custom_slug || enCounterpart.id.replace(/^en\//, '')) : null;
const alternateEnUrl = enSlug ? `${site}/article/${enSlug}/` : undefined;

// Sorted Indonesian posts for Previous / Next chronologically
const allSortedIdPosts = allPosts
  .filter((p) => p.id.startsWith('id/'))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const currentIndex = allSortedIdPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex < allSortedIdPosts.length - 1 ? allSortedIdPosts[currentIndex + 1] : null; // older
const nextPost = currentIndex > 0 ? allSortedIdPosts[currentIndex - 1] : null; // newer

// Related posts in Indonesian (up to 3 items in the same category, excluding current post)
const relatedPosts = allPosts
  .filter(
    (p) =>
      p.id.startsWith('id/') &&
      p.id !== post.id &&
      (p.data.category || '').toLowerCase() === (post.data.category || '').toLowerCase()
  )
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

// Author data lookup
const allAuthors = await getCollection('authors');
const authorEntry = allAuthors.find(
  (a) => a.data.name.toLowerCase() === (post.data.author || '').toLowerCase() && (a.id.startsWith('id/') || a.id.startsWith('id'))
) || allAuthors.find((a) => a.data.name.toLowerCase() === (post.data.author || '').toLowerCase());

const authorName = authorEntry?.data?.name || post.data.author || 'Tim Kukode';
const authorRole = authorEntry?.data?.role || 'Penulis Konten';
const authorBio = authorEntry?.data?.bio || 'Berpengalaman dalam bidang teknologi web, software engineering, dan bisnis digital.';
const authorAvatar = authorEntry?.data?.avatar || '/image/kukode-logo-transparent.png';
const authorEmail = authorEntry?.data?.email || '';
const authorInstagram = authorEntry?.data?.instagram || '';
const authorWebsite = authorEntry?.data?.website || '';
const authorSlug = authorEntry?.data?.custom_slug || authorEntry?.id.replace(/^(en|id)\//, '').replace(/\.(md|json)$/, '') || 'ahmad-muzakki';
const authorUrl = `/id/author/${authorSlug}/`;

const seoTitle = post.data.seo?.title || post.data.seo_title || post.data.title;
const seoDesc = post.data.seo?.description || post.data.seo_description || post.data.description || '';
const seoImage = post.data.seo?.image || post.data.seo_image || post.data.image;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": seoDesc,
  "image": seoImage ? `${site}${seoImage}` : undefined,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.updatedDate?.toISOString() || post.data.pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": authorName,
    "url": `${site}${authorUrl}`
  },
  "publisher": {
    "@type": "Organization",
    "name": "Kukode"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Beranda", "item": `${site}/id/` },
    { "@type": "ListItem", "position": 2, "name": "Artikel", "item": `${site}/id/article/` },
    { "@type": "ListItem", "position": 3, "name": post.data.title }
  ]
};
---

<BaseLayout
  title={`${seoTitle} | Kukode`}
  description={seoDesc}
  image={seoImage}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  author={post.data.author}
  schema={articleSchema}
  canonical={canonicalUrl}
  alternateEn={alternateEnUrl}
  alternateId={canonicalUrl}
  headerAlternateUrl={enSlug ? `/article/${enSlug}/` : '/article/'}
>
  <Fragment slot="head">
    <link href="/vendor/glightbox/css/glightbox.min.css" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main class="kk-template-page">
    <!-- Reading Progress Bar -->
    <div id="readingProgressBar" class="kk-reading-progress" style="width: 0%;"></div>

    <div class="container py-5">
      <article class="row gx-4 gx-lg-5">
        <div class="col-lg-8 mx-auto">
          <!-- Breadcrumbs -->
          <nav class="kk-badge-pill kk-breadcrumb-nav mb-3 small" aria-label="breadcrumb">
            <span class="kk-dot"></span>
            <a href="/id/" class="text-decoration-none">Beranda</a>
            <span class="mx-1 text-muted-kk">/</span>
            <a href="/id/article/" class="text-decoration-none">Artikel</a>
            <span class="mx-1 text-muted-kk">/</span>
            <span class="text-muted-kk">{post.data.title}</span>
          </nav>

          <h1 class="font-heading fw-bold mb-3">{post.data.title}</h1>

          <!-- Meta Post with Category, Date, Reading Time & Updated Date -->
          <div id="meta-post" class="d-flex justify-content-between align-items-center mt-3 mb-4 flex-wrap gap-2 pb-3 border-bottom">
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <a href={`/id/category/${post.data.category.toLowerCase()}/`} class="badge text-bg-primary text-decoration-none fw-normal fs-6">
                {post.data.category}
              </a>
              <span class="text-muted-kk small">&bull;</span>
              <time datetime={pubDateStr} class="text-muted-kk small">{pubDateStr}</time>
              <span class="text-muted-kk small">&bull;</span>
              <span class="text-muted-kk small d-inline-flex align-items-center gap-1">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                {readingTime} mnt baca
              </span>
            </div>
            {showUpdated && (
              <span class="badge text-bg-light border text-muted-kk small">
                Diperbarui: {updatedDateStr}
              </span>
            )}
          </div>

          {post.data.image && (
            <img src={post.data.image} alt={post.data.title} class="img-fluid rounded-2 mb-4 w-100" loading="eager" decoding="async" />
          )}

          <div class="article-body">
            <Content />
          </div>

          <!-- Social Share Buttons -->
          <SocialShare title={post.data.title} url={canonicalUrl} isId={true} />

          <!-- Author Box -->
          <div class="d-flex flex-column flex-sm-row gap-3 align-items-start border rounded-3 p-3 mt-4 bg-surface">
            <a href={authorUrl} class="text-decoration-none flex-shrink-0">
              <img
                src={authorAvatar}
                alt={authorName}
                class="rounded-circle border p-1"
                width="72"
                height="72"
                style="object-fit: cover;"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="flex-grow-1">
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                <div>
                  <h4 class="h6 font-heading fw-bold mb-0">
                    <a href={authorUrl} class="text-decoration-none text-reset">
                      {authorName}
                    </a>
                  </h4>
                  {authorRole && <p class="text-muted-kk small mb-0">{authorRole}</p>}
                </div>
                <a href={authorUrl} class="btn btn-outline-kk btn-sm small px-3 py-2">
                  Lihat Profil &rarr;
                </a>
              </div>
              {authorBio && <p class="text-muted-kk small mt-2 mb-2">{authorBio}</p>}
              <div class="d-flex gap-3 mt-2 flex-wrap">
                <div class="d-flex gap-2 mt-2 flex-wrap">
                  {authorInstagram && (
                    <a href={`https://instagram.com/${authorInstagram.replace('@', '')}`} target="_blank" rel="noopener noreferrer" class="kk-icon-circle kk-icon-circle-small link-primary" aria-label="Instagram" title="Instagram">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M8 12a4 4 0 1 1 8 0a4 4 0 0 1-8 0"/><path fill="currentColor" d="M12.05 1c1.827 0 3.266 0 4.42.105c1.178.106 2.156.328 3.03.833A7 7 0 0 1 22.062 4.5c.505.874.727 1.852.833 3.03C23 8.684 23 10.123 23 11.95v.1c0 1.827 0 3.266-.105 4.42c-.106 1.178-.328 2.156-.833 3.03a7 7 0 0 1-2.562 2.562c-.874.505-1.852.727-3.03.833c-1.154.105-2.593.105-4.42.105h-.1c-1.827 0-3.266 0-4.42-.105c-1.178-.106-2.156-.328-3.03-.833A7 7 0 0 1 1.938 19.5c-.505-.874-.727-1.852-.833-3.03C1 15.316 1 13.877 1 12.05v-.1c0-1.827 0-3.266.105-4.42c.106-1.178.328-2.156.833-3.03A7 7 0 0 1 4.5 1.938c.874-.505 1.852-.727 3.03-.833C8.684 1 10.123 1 11.95 1zm6.2 3.75a1 1 0 0 0-1 1v.004a1 1 0 0 0 1 1h.004a1 1 0 0 0 1-1V5.75a1 1 0 0 0-1-1zM12 6a6 6 0 1 0 0 12a6 6 0 0 0 0-12"/></svg>
                    </a>
                  )}
                  {authorWebsite && (
                    <a href={authorWebsite} target="_blank" rel="noopener noreferrer" class="kk-icon-circle kk-icon-circle-small link-primary" aria-label="Website" title="Website">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M18.64 2.89c-.8.09-1.63.48-2.47 1.13c-1.24-.65-2.62-1-4.06-1.02c-2.42 0-4.69.88-6.4 2.55A8.95 8.95 0 0 0 3 11.89a9 9 0 0 0 .58 3.31c-1.07 1.2-2.07 3.68-.83 5.08c.52.58 1.26.84 2.15.84c2.71 0 6.81-2.4 10.26-5.46c4.59-4.07 8.14-9.42 6.06-11.77a2.93 2.93 0 0 0-2.57-.98ZM4.24 18.94c-.22-.25 0-1.08.39-1.78c.28.39.58.77.92 1.12c.22.22.45.42.68.62c-1.05.32-1.76.3-1.99.03Zm15.25-11.9c-.31-.47-.65-.93-1.05-1.34c-.17-.17-.34-.33-.52-.48c.39-.22.7-.32.92-.35c.36-.04.63.06.86.32c.22.25.17.91-.22 1.84Zm-3.34 9.73c-1.64 1.46-3.67 2.96-5.72 4.08c.48.08.96.14 1.46.14h.12c2.37 0 4.59-.9 6.28-2.55c1.72-1.67 2.68-3.92 2.71-6.34c0-.23-.01-.45-.02-.68c-1.28 1.84-2.97 3.68-4.83 5.34Z"/></svg>
                    </a>
                  )}
                  {authorEmail && (
                    <a href={`mailto:${authorEmail}`} class="kk-icon-circle kk-icon-circle-small link-primary" aria-label="Email" title="Email">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M7.125 3.75h9.75c.813 0 1.468 0 2 .043c.546.045 1.026.14 1.47.366a3.75 3.75 0 0 1 1.64 1.639c.226.444.32.924.365 1.47q.01.12.016.247a.75.75 0 0 1 .014.336c.013.41.013.879.013 1.417v5.464c0 .813 0 1.469-.043 2c-.045.546-.14 1.026-.366 1.47a3.75 3.75 0 0 1-1.639 1.64c-.444.226-.924.32-1.47.365c-.532.043-1.187.043-2 .043h-9.75c-.813 0-1.468 0-2-.043c-.546-.045-1.026-.14-1.47-.366a3.75 3.75 0 0 1-1.639-1.639c-.226-.444-.32-.924-.365-1.47c-.044-.531-.044-1.187-.044-2V9.268c0-.538 0-1.007.013-1.417a.75.75 0 0 1 .014-.336q.007-.128.017-.246c.044-.547.139-1.027.365-1.471a3.75 3.75 0 0 1 1.639-1.64c.444-.226.924-.32 1.47-.365c.532-.043 1.187-.043 2-.043M20.85 7.341c-.038-.423-.105-.672-.202-.862a2.25 2.25 0 0 0-.983-.984c-.198-.1-.459-.17-.913-.207c-.462-.037-1.057-.038-1.909-.038H7.157c-.852 0-1.446 0-1.91.038c-.453.037-.714.107-.911.207a2.25 2.25 0 0 0-.984.984c-.096.19-.164.439-.202.862l6.604 4.403c1.01.674 1.363.895 1.722.981a2.25 2.25 0 0 0 1.048 0c.36-.086.711-.307 1.723-.981z"/></svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>

          <!-- Previous & Next Article Navigation -->
          {(prevPost || nextPost) && (
            <div class="row mt-4">
              <div class="col-sm-6">
                {prevPost && (
                  <a href={`/id/article/${prevPost.data.custom_slug || prevPost.id.replace(/^id\//, '')}/`} class="kk-post-nav card p-3 h-100 text-decoration-none">
                    <small class="text-muted-kk mb-1 d-block">Artikel Sebelumnya</small>
                    <span class="fw-bold fs-6">{prevPost.data.title}</span>
                  </a>
                )}
              </div>
              <div class="col-sm-6 text-sm-end">
                {nextPost && (
                  <a href={`/id/article/${nextPost.data.custom_slug || nextPost.id.replace(/^id\//, '')}/`} class="kk-post-nav card p-3 h-100 text-decoration-none">
                    <small class="text-muted-kk mb-1 d-block">Artikel Selanjutnya</small>
                    <span class="fw-bold fs-6">{nextPost.data.title}</span>
                  </a>
                )}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar TOC -->
        <div class="col-lg-4 d-none d-lg-block">
          <aside class="kk-toc-sidebar sticky-top" style="top: 6rem;">
            <p class="kk-toc-title mb-0 font-heading">Daftar Isi</p>
            <nav class="kk-toc-nav" id="kk-toc-nav"></nav>
          </aside>
        </div>
      </article>

      <!-- Related Posts Section (only renders if items exist) -->
      {relatedPosts.length > 0 && (
        <section class="mt-5 pt-5 border-top">
          <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
              <p class="kk-eyebrow mb-1">Artikel Terkait</p>
              <h3 class="h4 font-heading fw-bold mb-0">Lainnya di {post.data.category}</h3>
            </div>
            <a href={`/id/category/${post.data.category.toLowerCase()}/`} class="btn btn-outline-kk btn-sm">
              Lihat Semua &rarr;
            </a>
          </div>
          <div class="row g-3">
            {relatedPosts.map((rel) => {
              const relSlug = rel.data.custom_slug || rel.id.replace(/^id\//, '');
              const relPubDate = rel.data.pubDate.toISOString().split('T')[0];
              return (
                <div class="col-md-4">
                  <div class="kk-card p-2 h-100 d-flex flex-column">
                    <a href={`/id/article/${relSlug}/`} class="text-decoration-none text-reset flex-grow-1">
                      {rel.data.image && (
                        <img
                          src={rel.data.image}
                          alt={rel.data.title}
                          class="img-fluid rounded-3 w-100 aspect-ratio-16-9 bg-light"
                          style="min-height: 120px; object-fit: cover;"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                      <div class="m-2">
                        <div id="meta-post" class="d-flex justify-content-between mt-3 mb-1">
                          <span class="text-muted-kk small text-uppercase">{rel.data.category}</span>
                          <time datetime={relPubDate} class="text-muted-kk small">{relPubDate}</time>
                        </div>
                        <h4 class="h6 font-heading fw-bold mt-2 mb-1">{rel.data.title}</h4>
                        {rel.data.description && (
                          <p class="text-muted-kk small mb-0">{rel.data.description}</p>
                        )}
                      </div>
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      )}
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/vendor/glightbox/js/glightbox.min.js"></script>
    <script is:inline src="/js/kukode-article.js"></script>
  </Fragment>
</BaseLayout>
