---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { marked } from 'marked';
import DefaultTemplate from '../../page-template/Default.astro';
import AboutTemplate from '../../page-template/About.astro';
import ContactTemplate from '../../page-template/Contact.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ id, data }) =>
    id.startsWith('id/') && !data.draft
  );

  return pages.map((page) => ({
    params: { slug: page.data.custom_slug || page.data.slug_id || page.id.replace(/^id\//, '') },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);

const site = Astro.site?.toString().replace(/\/$/, '') || 'https://kukode.com';
const slug = page.data.custom_slug || page.data.slug_id || page.id.replace(/^id\//, '');

// Check for English counterpart (by translation_key or by base filename)
const allPages = await getCollection('pages', ({ data }) => !data.draft);
const enCounterpart = allPages.find((p) => {
  if (!p.id.startsWith('en/')) return false;
  if (page.data.translation_key && p.data.translation_key) {
    return p.data.translation_key === page.data.translation_key;
  }
  return p.id === page.id.replace(/^id\//, 'en/');
});

const enSlug = enCounterpart ? (enCounterpart.data.custom_slug || enCounterpart.data.slug_en || enCounterpart.id.replace(/^en\//, '')) : null;
const alternateEnUrl = enSlug ? `${site}/${enSlug}/` : undefined;

// Page object and template resolution
const pageObj = page.data.page || {};
const template = pageObj.template || 'default';
const pageTitle = pageObj.title || page.data.title || '';

// SEO resolution
const pageSeo = page.data.seo || pageObj.seo || {};
const seoTitle = pageSeo.title || pageSeo.meta_title || page.data.seo_title || pageTitle;
const seoDesc = pageSeo.description || pageSeo.meta_description || page.data.seo_description || page.data.description || '';
const seoImage = pageSeo.image || pageSeo.og_image || page.data.seo_image;

// Content markdown parsing if provided in page.content
const contentHtml = pageObj.content ? await marked.parse(pageObj.content) : null;

const templateMap: Record<string, any> = {
  default: DefaultTemplate,
  about: AboutTemplate,
  contact: ContactTemplate,
};
const TemplateComponent = templateMap[template] || DefaultTemplate;
---

<BaseLayout
  title={`${seoTitle} | Kukode`}
  description={seoDesc}
  image={seoImage}
  alternateEn={alternateEnUrl}
  alternateId={`${site}/id/${slug}/`}
  headerAlternateUrl={enSlug ? `/${enSlug}/` : '/'}
>
  <TemplateComponent page={page} pageData={pageObj} contentHtml={contentHtml}>
    <Content />
  </TemplateComponent>
</BaseLayout>
