---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const site = Astro.site?.toString().replace(/\/$/, '') || 'https://kukode.com';

// Fetch archive settings
const allSettings = await getCollection('settings');
const archiveSettings = allSettings.find(
  (s) => s.id === 'en/archives' || s.id === 'en/archives.json'
)?.data?.articles;

const allPosts = await getCollection('posts', ({ id, data }) =>
  id.startsWith('en/') && !data.draft
);
const posts = allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const title = archiveSettings?.seo_title || 'Articles & News | Kukode';
const description =
  archiveSettings?.seo_description ||
  'Read the latest articles about web development, business, and technology from Kukode.';
const seoImage = archiveSettings?.seo_image || '/image/default-thumbnail.jpg';
const headerTitle = archiveSettings?.header_title || 'What can We help you with your business?';
const headerDesc =
  archiveSettings?.header_description ||
  'Insights, tutorials, and news from the world of web development and digital business.';
---

<BaseLayout
  title={title}
  description={description}
  image={seoImage}
  alternateEn={`${site}/article/`}
  alternateId={`${site}/id/article/`}
>
  <main class="kk-template-page">
    <div class="container py-5">
      <div class="text-center mb-5">
        <p class="kk-eyebrow mb-3">Articles & News</p>
        <h1>{headerTitle}</h1>
        <p class="text-muted-kk">{headerDesc}</p>
      </div>

      <div class="d-flex justify-content-center gap-2 mb-4 flex-wrap">
        <a href="/article/" class="btn px-3 py-1 btn-primary">All</a>
        <a href="/category/information/" class="btn px-3 py-1 btn-outline-kk">Information</a>
        <a href="/category/website/" class="btn px-3 py-1 btn-outline-kk">Website</a>
        <a href="/category/tutorial/" class="btn px-3 py-1 btn-outline-kk">Tutorial</a>
      </div>

      <div class="row g-3">
        {posts.map(post => {
          const slug = post.data.custom_slug || post.id.replace(/^en\//, '');
          return (
            <div class="col-6 col-md-4">
              <div class="kk-card p-2">
                <a href={`/article/${slug}`} class="text-decoration-none text-reset">
                  {post.data.image && (
                    <img src={post.data.image} alt={post.data.title} class="img-fluid rounded-3 w-100 aspect-ratio-16-9 bg-light" style="min-height:100px;" loading="lazy" />
                  )}
                  <div class="m-2">
                    <div id="meta-post" class="d-flex justify-content-between mt-3">
                      <span class="text-muted-kk small text-uppercase">{post.data.category}</span>
                      <time datetime={post.data.pubDate.toISOString().split('T')[0]} class="text-muted-kk small mb-1 d-block">{post.data.pubDate.toISOString().split('T')[0]}</time>
                    </div>
                    <h3 class="h6 font-heading mt-2">{post.data.title}</h3>
                    {post.data.description && <p class="text-muted-kk small">{post.data.description}</p>}
                  </div>
                </a>
              </div>
            </div>
          );
        })}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-5">
          <p class="text-muted-kk">No articles yet. Check back soon!</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
