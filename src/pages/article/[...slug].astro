---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ id, data }) =>
    id.startsWith('en/') && !data.draft
  );

  return posts.map((post) => ({
    params: { slug: post.data.custom_slug || post.id.replace(/^en\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const site = Astro.site?.toString().replace(/\/$/, '') || 'https://kukode.com';
const slug = post.data.custom_slug || post.id.replace(/^en\//, '');
const pubDateStr = post.data.pubDate.toISOString().split('T')[0];

// Check for Indonesian counterpart (by translation_key or by base filename)
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const idCounterpart = allPosts.find((p) => {
  if (!p.id.startsWith('id/')) return false;
  if (post.data.translation_key && p.data.translation_key) {
    return p.data.translation_key === post.data.translation_key;
  }
  return p.id === post.id.replace(/^en\//, 'id/');
});

const idSlug = idCounterpart ? (idCounterpart.data.custom_slug || idCounterpart.id.replace(/^id\//, '')) : null;
const alternateIdUrl = idSlug ? `${site}/id/article/${idSlug}` : undefined;

// Author data lookup
const allAuthors = await getCollection('authors');
const authorEntry = allAuthors.find(
  (a) => a.data.name.toLowerCase() === (post.data.author || '').toLowerCase() && (a.id.startsWith('en/') || a.id.startsWith('en'))
) || allAuthors.find((a) => a.data.name.toLowerCase() === (post.data.author || '').toLowerCase());

const authorName = authorEntry?.data?.name || post.data.author || 'Kukode Team';
const authorRole = authorEntry?.data?.role || 'Content Writer';
const authorBio = authorEntry?.data?.bio || 'Passionate about web technology, software engineering, and digital business.';
const authorAvatar = authorEntry?.data?.avatar || '/image/kukode-logo-transparent.png';
const authorEmail = authorEntry?.data?.email || '';
const authorInstagram = authorEntry?.data?.instagram || '';
const authorWebsite = authorEntry?.data?.website || '';
const authorSlug = authorEntry?.data?.custom_slug || authorEntry?.id.replace(/^(en|id)\//, '').replace(/\.(md|json)$/, '') || 'ahmad-muzakki';
const authorUrl = `/author/${authorSlug}/`;

const seoTitle = post.data.seo_title || post.data.title;
const seoDesc = post.data.seo_description || post.data.description || '';
const seoImage = post.data.seo_image || post.data.image;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": seoDesc,
  "image": seoImage ? `${site}${seoImage}` : undefined,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.updatedDate?.toISOString() || post.data.pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": authorName,
    "url": `${site}${authorUrl}`
  },
  "publisher": {
    "@type": "Organization",
    "name": "Kukode"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${site}/` },
    { "@type": "ListItem", "position": 2, "name": "Articles", "item": `${site}/article/` },
    { "@type": "ListItem", "position": 3, "name": post.data.title }
  ]
};
---

<BaseLayout
  title={`${seoTitle} | Kukode`}
  description={seoDesc}
  image={seoImage}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  author={post.data.author}
  schema={articleSchema}
  alternateEn={`${site}/article/${slug}`}
  alternateId={alternateIdUrl}
  headerAlternateUrl={idSlug ? `/id/article/${idSlug}` : '/id/article/'}
>
  <Fragment slot="head">
    <link href="/vendor/glightbox/css/glightbox.min.css" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main class="kk-template-page">
    <div class="container py-5">
      <article class="row gx-4 gx-lg-5">
        <div class="col-lg-8 mx-auto">
          <!-- Breadcrumbs -->
          <nav class="kk-breadcrumb-nav mb-3">
            <a href="/" class="text-decoration-none text-muted-kk">Home</a>
            <span class="mx-1 text-muted-kk">/</span>
            <a href="/article/" class="text-decoration-none text-muted-kk">Articles</a>
            <span class="mx-1 text-muted-kk">/</span>
            <span class="text-muted-kk">{post.data.title}</span>
          </nav>

          <h1>{post.data.title}</h1>

          <div id="meta-post" class="d-flex justify-content-between align-items-center mt-3 mb-4 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
              <a href={authorUrl} class="text-decoration-none text-muted-kk small fw-semibold d-flex align-items-center gap-2">
                <img src={authorAvatar} alt={authorName} class="rounded-circle border" width="26" height="26" style="object-fit:cover;" />
                <span>{authorName}</span>
              </a>
              <span class="text-muted-kk small">&bull;</span>
              <a href={`/category/${post.data.category.toLowerCase()}`} class="text-muted-kk small text-uppercase text-decoration-none">{post.data.category}</a>
            </div>
            <time datetime={pubDateStr} class="text-muted-kk small">{pubDateStr}</time>
          </div>

          {post.data.image && (
            <img src={post.data.image} alt={post.data.title} class="img-fluid rounded-1 mb-3 w-100" />
          )}

          <div class="article-body">
            <Content />
          </div>

          <!-- Author Box -->
          <div class="d-flex flex-column flex-sm-row gap-3 align-items-start border rounded-2 p-4 mt-5 bg-surface">
            <a href={authorUrl} class="text-decoration-none flex-shrink-0">
              <img
                src={authorAvatar}
                alt={authorName}
                class="rounded-circle border"
                width="72"
                height="72"
                style="object-fit: cover;"
                loading="lazy"
              />
            </a>
            <div class="flex-grow-1">
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                <div>
                  <h4 class="h6 font-heading fw-bold mb-0">
                    <a href={authorUrl} class="text-decoration-none text-reset">
                      {authorName}
                    </a>
                  </h4>
                  {authorRole && <p class="text-muted-kk small mb-0">{authorRole}</p>}
                </div>
                <a href={authorUrl} class="btn btn-outline-kk btn-sm py-1 px-2 small">
                  View Profile &rarr;
                </a>
              </div>
              {authorBio && <p class="text-muted-kk small mt-2 mb-2">{authorBio}</p>}
              <div class="d-flex gap-3 mt-2 flex-wrap">
                {authorInstagram && (
                  <a href={`https://instagram.com/${authorInstagram.replace('@', '')}`} target="_blank" rel="noopener noreferrer" class="text-muted-kk small text-decoration-none d-flex align-items-center gap-1">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    Instagram
                  </a>
                )}
                {authorWebsite && (
                  <a href={authorWebsite} target="_blank" rel="noopener noreferrer" class="text-muted-kk small text-decoration-none d-flex align-items-center gap-1">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                    Website
                  </a>
                )}
                {authorEmail && (
                  <a href={`mailto:${authorEmail}`} class="text-muted-kk small text-decoration-none d-flex align-items-center gap-1">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    Email
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar TOC -->
        <div class="col-lg-4 d-none d-lg-block">
          <aside class="kk-toc-sidebar sticky-top" style="top: 6rem;">
            <p class="kk-toc-title mb-0 font-heading">Table of Contents</p>
            <nav class="kk-toc-nav" id="kk-toc-nav"></nav>
          </aside>
        </div>
      </article>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/vendor/glightbox/js/glightbox.min.js"></script>
    <script is:inline src="/js/kukode-article.js"></script>
  </Fragment>
</BaseLayout>
