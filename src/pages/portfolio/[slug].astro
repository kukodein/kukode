---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('portfolio', ({ data }) => !data.draft);

  return projects.map((project) => ({
    params: { slug: project.data.custom_slug || project.id.replace(/\.(md|mdx)$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const site = Astro.site?.toString().replace(/\/$/, '') || 'https://kukode.com';
const slug = project.data.custom_slug || project.id.replace(/\.(md|mdx)$/, '');

const title = project.data.seo?.title || project.data.seo_title || `${project.data.title} | Portfolio - Kukode`;
const description = project.data.seo?.description || project.data.seo_description || project.data.description || 'Case study and project details.';
const projectImage = project.data.seo?.image || project.data.seo_image || project.data.image || '/image/default-thumbnail.jpg';

// Fetch archive settings for CTA band
const allSettings = await getCollection('settings');
const portfolioSettings = (
  allSettings.find((s) => s.id === 'en/archives' || s.id === 'en/archives.json') ||
  allSettings.find((s) => s.id === 'archives' || s.id === 'archives.json')
)?.data?.portfolio;

const cta = portfolioSettings?.cta || {
  eyebrow: "Let's Work Together",
  heading: 'Want a website that converts like this?',
  description: "Tell us about your project requirements and let's create something exceptional.",
  primary_text: 'Get a Free Consultation',
  primary_link: '/#contact',
  secondary_text: 'Chat on WhatsApp',
  secondary_link: 'https://wa.me/62853293353541',
};

// Other projects for the "More Work" section
const allProjects = await getCollection('portfolio', ({ id, data }) => !data.draft && id !== project.id);
const otherProjects = allProjects.slice(0, 3);

// Normalized gallery items
const rawGallery = project.data.gallery || [];
const galleryItems = rawGallery.map((item: any) => {
  if (typeof item === 'string') {
    return { image: item, caption: '' };
  }
  return {
    image: item?.image || '',
    caption: item?.caption || item?.alt || '',
  };
}).filter((item: any) => Boolean(item.image));
---

<BaseLayout
  title={title}
  description={description}
  image={projectImage}
  noindex={true}
  canonical={`${site}/portfolio/${slug}/`}
  headerAlternateUrl="/id/"
>
  <Fragment slot="head">
    <link href="/vendor/glightbox/css/glightbox.min.css" rel="stylesheet" />
  </Fragment>

  <main class="kk-template-page">
    <div class="container py-5">
      <!-- Breadcrumbs -->
      <nav class="kk-breadcrumb-nav mb-4 small" aria-label="breadcrumb">
        <a href="/" class="text-decoration-none">Home</a>
        <span class="mx-1 text-muted-kk">/</span>
        <a href="/portfolio/" class="text-decoration-none">Portfolio</a>
        <span class="mx-1 text-muted-kk">/</span>
        <span class="text-muted-kk">{project.data.title}</span>
      </nav>

      <!-- Project Header -->
      <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge text-bg-primary fw-normal fs-6">{project.data.category}</span>
          {project.data.year && <span class="text-muted-kk small">• {project.data.year}</span>}
        </div>
        <h1 class="display-6 font-heading fw-bold mb-3">{project.data.title}</h1>
        {project.data.description && (
          <p class="fs-5 text-muted-kk mb-4" style="max-width: 780px;">
            {project.data.description}
          </p>
        )}

        <!-- Meta Summary Bar -->
        <div class="p-3 p-md-4 rounded-2 border bg-surface d-flex flex-wrap gap-4 align-items-center justify-content-between mb-5">
          <div class="d-flex flex-wrap gap-4 align-items-center">
            {project.data.client && (
              <div>
                <span class="text-muted-kk small d-block">Client</span>
                <strong class="small">{project.data.client}</strong>
              </div>
            )}
            {project.data.category && (
              <div>
                <span class="text-muted-kk small d-block">Service</span>
                <strong class="small">{project.data.category}</strong>
              </div>
            )}
            {project.data.tools && project.data.tools.length > 0 && (
              <div>
                <span class="text-muted-kk small d-block mb-1">Tech Stack</span>
                <div class="d-flex flex-wrap gap-1">
                  {project.data.tools.map((tool) => (
                    <span class="badge rounded-pill text-body border small">{tool}</span>
                  ))}
                </div>
              </div>
            )}
          </div>
          {project.data.live_url && (
            <a
              href={project.data.live_url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2"
            >
              <span>Visit Live Website</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          )}
        </div>
      </div>

      <!-- Featured Browser Frame (design matching homepage) -->
      {project.data.image && (
        <div class="kk-browser-frame shadow mb-5">
          <div class="kk-browser-bar"><span></span><span></span><span></span></div>
          <div class="kk-browser-body">
            <img src={project.data.image} alt={project.data.title} class="img-fluid w-100" style="max-height: 580px; object-fit: cover;" />
          </div>
        </div>
      )}

      <!-- Case Study Body -->
      <article class="row gx-4 gx-lg-5 justify-content-center">
        <div class="col-lg-9">
          <div class="article-body">
            <Content />
          </div>
        </div>
      </article>

      <!-- Project Gallery Section -->
      {galleryItems.length > 0 && (
        <section class="mt-5 pt-4 border-top" id="project-gallery">
          <div class="mb-4">
            <p class="kk-eyebrow mb-1">Visual Showcase</p>
            <h2 class="h3 font-heading fw-bold mb-2">Project Gallery & Screenshots</h2>
            <p class="text-muted-kk small">Click any screenshot to zoom and preview in full resolution.</p>
          </div>
          <div class="row g-3 g-md-4">
            {galleryItems.map((item: any, index: number) => {
              const imageCaption = item.caption || `${project.data.title} - Screenshot ${index + 1}`;
              return (
                <div class="col-6 col-md-4 col-lg-3">
                  <a
                    href={item.image}
                    class="glightbox kk-gallery-item d-block rounded-3 overflow-hidden border bg-surface position-relative shadow-sm text-decoration-none"
                    data-gallery="portfolio-gallery"
                    data-title={imageCaption}
                  >
                    <img
                      src={item.image}
                      alt={imageCaption}
                      class="img-fluid w-100 object-fit-cover"
                      style="height: 220px;"
                      loading="lazy"
                    />
                    <div class="kk-gallery-overlay d-flex align-items-center justify-content-center">
                      <span class="btn btn-sm btn-light rounded-pill px-3 py-1 shadow-sm d-inline-flex align-items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
                        <span>Zoom</span>
                      </span>
                    </div>
                  </a>
                  {item.caption && (
                    <p class="text-muted-kk small mt-2 mb-0 text-center">{item.caption}</p>
                  )}
                </div>
              );
            })}
          </div>
        </section>
      )}

      <!-- More Projects Section -->
      {otherProjects.length > 0 && (
        <section class="mt-5 pt-5 border-top">
          <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
              <p class="kk-eyebrow mb-1">More Work</p>
              <h2 class="h3 font-heading fw-bold mb-0">Other Selected Projects</h2>
            </div>
            <a href="/portfolio/" class="btn btn-outline-kk btn-sm">View All Projects &rarr;</a>
          </div>
          <div class="row g-4">
            {otherProjects.map((item) => {
              const otherSlug = item.data.custom_slug || item.id.replace(/\.(md|mdx)$/, '');
              return (
                <div class="col-md-4">
                  <a href={`/portfolio/${otherSlug}/`} class="kk-portfolio-card text-decoration-none text-reset d-block h-100">
                    <div class="kk-browser-frame">
                      <div class="kk-browser-bar"><span></span><span></span><span></span></div>
                      <div class="kk-browser-body">
                        {item.data.image && (
                          <img src={item.data.image} alt={item.data.title} width="600" height="400" loading="lazy" />
                        )}
                        <div class="kk-overlay"><span class="btn btn-light btn-sm rounded-pill">View case study</span></div>
                      </div>
                    </div>
                    <div class="m-2">
                      <p class="text-muted-kk small mt-2 mb-1">{item.data.category}</p>
                      <h3 class="h6 font-heading fw-bold">{item.data.title}</h3>
                    </div>
                  </a>
                </div>
              );
            })}
          </div>
        </section>
      )}

      <!-- Bottom CTA Band -->
      <div class="kk-cta-band mt-5">
        {cta.eyebrow && <p class="kk-eyebrow mb-2" style="color: rgba(255,255,255,0.85);">{cta.eyebrow}</p>}
        {cta.heading && <h2 class="mb-3">{cta.heading}</h2>}
        {cta.description && (
          <p class="mb-4 mx-auto" style="max-width: 480px;">
            {cta.description}
          </p>
        )}
        <div class="d-flex gap-3 justify-content-center flex-wrap">
          {cta.primary_text && (
            <a href={cta.primary_link || '/#contact'} class="btn btn-light">{cta.primary_text}</a>
          )}
          {cta.secondary_text && (
            <a href={cta.secondary_link || 'https://wa.me/62853293353541'} target="_blank" rel="noopener noreferrer" class="btn btn-outline-light">{cta.secondary_text}</a>
          )}
        </div>
      </div>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/vendor/glightbox/js/glightbox.min.js"></script>
    <script is:inline>
      let portfolioLightboxInstance = null;
      function initPortfolioLightbox() {
        if (typeof GLightbox !== 'undefined') {
          if (portfolioLightboxInstance) {
            try { portfolioLightboxInstance.destroy(); } catch (e) {}
          }
          portfolioLightboxInstance = GLightbox({
            selector: '.glightbox',
            touchNavigation: true,
            loop: true,
            zoomable: true,
            openEffect: 'zoom',
            closeEffect: 'zoom'
          });
        }
      }
      document.addEventListener('DOMContentLoaded', initPortfolioLightbox);
      document.addEventListener('astro:page-load', initPortfolioLightbox);
    </script>
  </Fragment>
</BaseLayout>

