---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }) {
  const categories = await getCollection('categories', ({ id }) =>
    id.startsWith('en/')
  );
  const posts = await getCollection(
    'posts',
    ({ id, data }) => id.startsWith('en/') && !data.draft
  );

  const categoriesWithCount = categories
    .map((cat) => {
      const catName = cat.data.name.toLowerCase();
      const count = posts.filter((p) => {
        const postCat = p.data.category?.toLowerCase();
        return (
          postCat === catName ||
          (catName === 'information' && postCat === 'informasi') ||
          (catName === 'website' && postCat === 'situs web') ||
          (catName === 'tutorial' && postCat === 'panduan')
        );
      }).length;
      const slug =
        cat.data.custom_slug ||
        cat.data.slug_en ||
        cat.id.replace(/^en\//, '').replace(/\.(md|json)$/, '');
      return {
        ...cat,
        count,
        slug,
      };
    })
    .filter((cat) => cat.count > 0);

  return paginate(categoriesWithCount, { pageSize: 12 });
}

const { page } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://kukode.com';

// Fetch archive settings
const allSettings = await getCollection('settings');
const archiveSettings = (
  allSettings.find((s) => s.id === 'en/archives' || s.id === 'en/archives.json') ||
  allSettings.find((s) => s.id === 'archives' || s.id === 'archives.json')
)?.data?.categories;

const baseTitle = archiveSettings?.seo?.title || archiveSettings?.seo_title || 'All Categories | Kukode';
const title = page.currentPage > 1 ? `${baseTitle.replace(/ \| Kukode$/, '')} - Page ${page.currentPage} | Kukode` : baseTitle;
const description =
  archiveSettings?.seo?.description ||
  archiveSettings?.seo_description ||
  'Browse articles and guides across all topics and categories on Kukode.';
const seoImage = archiveSettings?.seo?.image || archiveSettings?.seo_image || '/image/default-thumbnail.jpg';
const headerTitle = archiveSettings?.header_title || 'Explore by Category';
const headerDesc =
  archiveSettings?.header_description ||
  'Browse articles, tutorials, and guides grouped by topics to help your digital journey.';

const currentUrl = page.currentPage === 1 ? `${site}/category/` : `${site}/category/${page.currentPage}/`;
const alternateId = page.currentPage === 1 ? `${site}/id/category/` : `${site}/id/category/${page.currentPage}/`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Categories', item: `${site}/category/` },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={seoImage}
  canonical={currentUrl}
  alternateEn={currentUrl}
  alternateId={alternateId}
  headerAlternateUrl={page.currentPage === 1 ? '/id/category/' : `/id/category/${page.currentPage}/`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main class="kk-template-page">
    <div class="container py-5">
      
      <!-- Header -->
      <div class="text-center mb-5">
        <!-- Breadcrumbs -->
        <nav class="kk-badge-pill kk-breadcrumb-nav mb-2">
          <span class="kk-dot"></span>
          <a href="/" class="text-decoration-none">Home</a>
          <span class="mx-1 text-muted-kk">/</span>
          <span class="text-muted-kk">Categories</span>
          {page.currentPage > 1 && (
            <>
              <span class="mx-1 text-muted-kk">/</span>
              <span class="text-muted-kk">Page {page.currentPage}</span>
            </>
          )}
        </nav>
        <h1 class="display-5 font-heading fw-bold mb-3">{headerTitle}</h1>
        <p class="text-muted-kk mx-auto fs-5" style="max-width: 640px;">
          {headerDesc}
        </p>
      </div>

      <!-- Categories Grid -->
      <div class="row g-4 mb-5">
        {page.data.map((cat) => (
          <div class="col-md-6 col-lg-4">
            <div class="kk-card p-4 h-100 bg-surface border d-flex flex-column justify-content-between">
              <div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h2 class="h4 font-heading fw-bold mb-0">
                    <a href={`/category/${cat.slug}/`} class="text-decoration-none text-reset">
                      {cat.data.name}
                    </a>
                  </h2>
                  <span class="badge text-bg-primary fw-normal">
                    {cat.count} Articles
                  </span>
                </div>
                {cat.data.description && (
                  <p class="text-muted-kk small mb-0">{cat.data.description}</p>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      {page.data.length === 0 && (
        <div class="text-center py-5">
          <p class="text-muted-kk">No categories available at the moment.</p>
        </div>
      )}

      <!-- Pagination Component -->
      <Pagination page={page} />
    </div>
  </main>
</BaseLayout>

