---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categories = await getCollection('categories', ({ id }) =>
    id.startsWith('en/')
  );

  return categories.map((category) => {
    const slug =
      category.data.custom_slug ||
      category.data.slug_en ||
      category.id.replace(/^en\//, '');
    return {
      params: { slug },
      props: { category },
    };
  });
}

const { category } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://kukode.com';
const slug =
  category.data.custom_slug ||
  category.data.slug_en ||
  category.id.replace(/^en\//, '');

// Fetch all categories for filter buttons
const allCategories = await getCollection('categories', ({ id }) =>
  id.startsWith('en/')
);

// Fetch all English posts matching this category
const allPosts = await getCollection('posts', ({ id, data }) =>
  id.startsWith('en/') && !data.draft
);
const posts = allPosts
  .filter(
    (post) =>
      post.data.category?.toLowerCase() === category.data.name.toLowerCase()
  )
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );

// Find counterpart Indonesian category
const allIdCategories = await getCollection('categories', ({ id }) =>
  id.startsWith('id/')
);
const idCounterpart = allIdCategories.find((c) => {
  if (category.data.translation_key && c.data.translation_key) {
    return c.data.translation_key === category.data.translation_key;
  }
  return c.id === category.id.replace(/^en\//, 'id/');
});
const idSlug = idCounterpart
  ? idCounterpart.data.custom_slug ||
    idCounterpart.data.slug_id ||
    idCounterpart.id.replace(/^id\//, '')
  : null;

const alternateEnUrl = `${site}/category/${slug}/`;
const alternateIdUrl = idSlug ? `${site}/id/category/${idSlug}/` : undefined;
const headerAlternateUrl = idSlug ? `/id/category/${idSlug}/` : '/id/article/';

const title = `${category.data.name} | Articles & News | Kukode`;
const description =
  category.data.description ||
  `Explore articles, tutorials, and insights in ${category.data.name} from Kukode.`;
---

<BaseLayout
  title={title}
  description={description}
  alternateEn={alternateEnUrl}
  alternateId={alternateIdUrl}
  headerAlternateUrl={headerAlternateUrl}
>
  <main class="kk-template-page">
    <div class="container py-5">
      <div class="text-center mb-5">
        <nav class="kk-eyebrow kk-breadcrumb-nav mb-3">
          <a href="/" class="text-decoration-none text-muted-kk">Home</a>
          <span class="mx-1 text-muted-kk">/</span>
          <a href="/article/" class="text-decoration-none text-muted-kk">Articles</a>
          <span class="mx-1 text-muted-kk">/</span>
          <span class="text-muted-kk">{category.data.name}</span>
        </nav>
        <h1>{category.data.name}</h1>
        {category.data.description && (
          <p class="text-muted-kk mx-auto" style="max-width: 600px;">
            {category.data.description}
          </p>
        )}
      </div>

      <!-- Category Filter Tabs -->
      <div class="d-flex justify-content-center gap-2 mb-4 flex-wrap">
        <a href="/article/" class="btn px-3 py-1 btn-outline-kk">All</a>
        {allCategories.map((cat) => {
          const catSlug =
            cat.data.custom_slug ||
            cat.data.slug_en ||
            cat.id.replace(/^en\//, '');
          const isActive = catSlug === slug;
          return (
            <a
              href={`/category/${catSlug}/`}
              class={`btn px-3 py-1 ${isActive ? 'btn-primary' : 'btn-outline-kk'}`}
            >
              {cat.data.name}
            </a>
          );
        })}
      </div>

      <!-- Articles Grid -->
      <div class="row g-3">
        {posts.map((post) => {
          const postSlug =
            post.data.custom_slug || post.id.replace(/^en\//, '');
          return (
            <div class="col-6 col-md-4">
              <div class="kk-card p-2">
                <a href={`/article/${postSlug}`} class="text-decoration-none text-reset">
                  {post.data.image && (
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      class="img-fluid rounded-3 w-100 aspect-ratio-16-9 bg-light"
                      style="min-height:100px;"
                      loading="lazy"
                    />
                  )}
                  <div class="m-2">
                    <div id="meta-post" class="d-flex justify-content-between mt-3">
                      <span class="text-muted-kk small text-uppercase">
                        {post.data.category}
                      </span>
                      <time
                        datetime={post.data.pubDate.toISOString().split('T')[0]}
                        class="text-muted-kk small mb-1 d-block"
                      >
                        {post.data.pubDate.toISOString().split('T')[0]}
                      </time>
                    </div>
                    <h3 class="h6 font-heading mt-2">{post.data.title}</h3>
                    {post.data.description && (
                      <p class="text-muted-kk small">{post.data.description}</p>
                    )}
                  </div>
                </a>
              </div>
            </div>
          );
        })}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-5">
          <p class="text-muted-kk">No articles found in this category yet.</p>
          <a href="/article/" class="btn btn-outline-kk btn-sm mt-2">View All Articles</a>
        </div>
      )}
    </div>
  </main>
</BaseLayout>

