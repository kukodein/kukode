---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }) {
  const authors = await getCollection('authors', ({ id }) => id.startsWith('en/'));
  return paginate(authors, { pageSize: 12 });
}

const { page } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://kukode.com';

// Fetch archive settings
const allSettings = await getCollection('settings');
const archiveSettings = (
  allSettings.find((s) => s.id === 'en/archives' || s.id === 'en/archives.json') ||
  allSettings.find((s) => s.id === 'archives' || s.id === 'archives.json')
)?.data?.authors;

const baseTitle = archiveSettings?.seo?.title || archiveSettings?.seo_title || 'Authors & Contributors | Kukode';
const title = page.currentPage > 1 ? `${baseTitle.replace(/ \| Kukode$/, '')} - Page ${page.currentPage} | Kukode` : baseTitle;
const description =
  archiveSettings?.seo?.description ||
  archiveSettings?.seo_description ||
  'Meet the expert authors and technical contributors writing for Kukode.';
const seoImage = archiveSettings?.seo?.image || archiveSettings?.seo_image || '/image/default-thumbnail.jpg';
const headerTitle = archiveSettings?.header_title || 'Authors & Contributors';
const headerDesc =
  archiveSettings?.header_description ||
  "Meet the minds behind Kukode's guides, tutorials, and technical insights.";

const currentUrl = page.currentPage === 1 ? `${site}/author/` : `${site}/author/${page.currentPage}/`;
const alternateId = page.currentPage === 1 ? `${site}/id/author/` : `${site}/id/author/${page.currentPage}/`;
---

<BaseLayout
  title={title}
  description={description}
  image={seoImage}
  canonical={currentUrl}
  alternateEn={currentUrl}
  alternateId={alternateId}
  headerAlternateUrl={page.currentPage === 1 ? '/id/author/' : `/id/author/${page.currentPage}/`}
>
  <main class="kk-template-page">
    <div class="container py-5">
      <div class="text-center mb-5">
         <!-- Breadcrumbs -->
        <nav class="kk-badge-pill kk-breadcrumb-nav mb-2" aria-label="breadcrumb">
          <span class="kk-dot"></span>
          <a href="/" class="text-decoration-none">Home</a>
          <span class="mx-1 text-muted-kk">/</span>
          <span class="text-muted-kk">Authors</span>
          {page.currentPage > 1 && (
            <>
              <span class="mx-1 text-muted-kk">/</span>
              <span class="text-muted-kk">Page {page.currentPage}</span>
            </>
          )}
        </nav>
        <h1 class="font-heading fw-bold">{headerTitle}</h1>
        <p class="text-muted-kk mx-auto" style="max-width: 540px;">
          {headerDesc}
        </p>
      </div>

      <div class="row g-4 justify-content-center">
        {page.data.map((author) => {
          const slug = author.data.custom_slug || author.id.replace(/^en\//, '').replace(/\.(md|json)$/, '');
          const authorAvatar = author.data.avatar || '/image/kukode-logo-transparent.png';
          return (
            <div class="col-md-6 col-lg-4">
              <div class="kk-card p-4 h-100 text-center bg-surface border d-flex flex-column align-items-center">
                <a href={`/author/${slug}/`} class="text-decoration-none">
                  <img
                    src={authorAvatar}
                    alt={author.data.name}
                    class="rounded-circle border mb-3 shadow-sm"
                    width="96"
                    height="96"
                    style="object-fit: cover;"
                    loading="lazy"
                  />
                </a>
                <h3 class="h5 font-heading fw-bold mb-1">
                  <a href={`/author/${slug}/`} class="text-decoration-none text-reset">
                    {author.data.name}
                  </a>
                </h3>
                {author.data.role && (
                  <span class="badge text-bg-primary fw-normal mb-3">{author.data.role}</span>
                )}
                {author.data.bio && (
                  <p class="text-muted-kk small mb-4 flex-grow-1">{author.data.bio}</p>
                )}
                <a href={`/author/${slug}/`} class="btn btn-outline-kk btn-sm w-100 mt-auto">
                  View Articles &rarr;
                </a>
              </div>
            </div>
          );
        })}
      </div>

      {page.data.length === 0 && (
        <div class="text-center py-5">
          <p class="text-muted-kk">No authors found.</p>
        </div>
      )}

      <!-- Pagination Component -->
      <Pagination page={page} />
    </div>
  </main>
</BaseLayout>

