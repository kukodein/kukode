---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const authors = await getCollection('authors', ({ id }) => id.startsWith('en/'));

  return authors.map((author) => ({
    params: { slug: author.data.custom_slug || author.id.replace(/^en\//, '').replace(/\.(md|json)$/, '') },
    props: { author },
  }));
}

const { author } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') || 'https://kukode.com';
const slug = author.data.custom_slug || author.id.replace(/^en\//, '').replace(/\.(md|json)$/, '');

// Find articles written by this author
const allPosts = await getCollection('posts', ({ id, data }) =>
  id.startsWith('en/') && !data.draft && data.author.toLowerCase() === author.data.name.toLowerCase()
);
const posts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Check for Indonesian author counterpart
const allAuthors = await getCollection('authors');
const idAuthor = allAuthors.find((a) => {
  if (!a.id.startsWith('id/')) return false;
  return (
    a.data.name.toLowerCase() === author.data.name.toLowerCase() ||
    a.id.replace(/^id\//, '').replace(/\.(md|json)$/, '') === slug
  );
});

const idSlug = idAuthor
  ? idAuthor.data.custom_slug || idAuthor.id.replace(/^id\//, '').replace(/\.(md|json)$/, '')
  : null;
const alternateIdUrl = idSlug ? `${site}/id/author/${idSlug}/` : undefined;

const title = author.data.seo_title || `${author.data.name} - Author at Kukode`;
const description =
  author.data.seo_description ||
  author.data.bio ||
  `Read articles and guides written by ${author.data.name} at Kukode.`;
const authorAvatar = author.data.avatar || '/image/kukode-logo-transparent.png';
const fullAvatarUrl = authorAvatar.startsWith('http') ? authorAvatar : `${site}${authorAvatar}`;

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: author.data.name,
    jobTitle: author.data.role || 'Author',
    description: author.data.bio || description,
    image: fullAvatarUrl,
    sameAs: [
      author.data.website,
      author.data.instagram ? `https://instagram.com/${author.data.instagram.replace('@', '')}` : undefined,
    ].filter(Boolean),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Authors', item: `${site}/author/` },
    { '@type': 'ListItem', position: 3, name: author.data.name },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={authorAvatar}
  schema={profileSchema}
  alternateEn={`${site}/author/${slug}/`}
  alternateId={alternateIdUrl}
  headerAlternateUrl={idSlug ? `/id/author/${idSlug}/` : '/id/author/'}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main class="kk-template-page">
    <div class="container py-5">
      <!-- Breadcrumbs -->
      <nav class="kk-breadcrumb-nav mb-4">
        <a href="/" class="text-decoration-none text-muted-kk">Home</a>
        <span class="mx-1 text-muted-kk">/</span>
        <a href="/author/" class="text-decoration-none text-muted-kk">Authors</a>
        <span class="mx-1 text-muted-kk">/</span>
        <span class="text-muted-kk">{author.data.name}</span>
      </nav>

      <!-- Author Profile Card -->
      <div class="kk-card p-4 p-md-5 mb-5 bg-surface border">
        <div class="row align-items-center g-4">
          <div class="col-auto text-center">
            <img
              src={authorAvatar}
              alt={author.data.name}
              class="rounded-circle border shadow-sm"
              width="120"
              height="120"
              style="object-fit: cover;"
              loading="eager"
            />
          </div>
          <div class="col">
            <span class="badge text-bg-primary fw-normal mb-2">{author.data.role || 'Author'}</span>
            <h1 class="h2 font-heading fw-bold mb-2">{author.data.name}</h1>
            {author.data.bio && <p class="text-muted-kk fs-6 mb-3">{author.data.bio}</p>}

            <!-- Social / Contact Links -->
            <div class="d-flex gap-3 flex-wrap align-items-center mt-3">
              {author.data.instagram && (
                <a
                  href={`https://instagram.com/${author.data.instagram.replace('@', '')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-outline-kk btn-sm d-flex align-items-center gap-1"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  Instagram
                </a>
              )}
              {author.data.website && (
                <a
                  href={author.data.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-outline-kk btn-sm d-flex align-items-center gap-1"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                  Website
                </a>
              )}
              {author.data.email && (
                <a
                  href={`mailto:${author.data.email}`}
                  class="btn btn-outline-kk btn-sm d-flex align-items-center gap-1"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                  Email
                </a>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- Articles Section -->
      <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
          <p class="kk-eyebrow mb-1">Publications</p>
          <h2 class="h3 font-heading fw-bold mb-0">Articles by {author.data.name}</h2>
        </div>
        <span class="text-muted-kk small">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</span>
      </div>

      <div class="row g-3">
        {posts.map((post) => {
          const postSlug = post.data.custom_slug || post.id.replace(/^en\//, '');
          const pubDateStr = post.data.pubDate.toISOString().split('T')[0];
          return (
            <div class="col-6 col-md-4">
              <div class="kk-card p-2 h-100 d-flex flex-column">
                <a href={`/article/${postSlug}/`} class="text-decoration-none text-reset flex-grow-1">
                  {post.data.image && (
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      class="img-fluid rounded-3 w-100 aspect-ratio-16-9 bg-light"
                      style="min-height: 120px; object-fit: cover;"
                      loading="lazy"
                    />
                  )}
                  <div class="m-2">
                    <div id="meta-post" class="d-flex justify-content-between mt-3 mb-1">
                      <span class="text-muted-kk small text-uppercase">{post.data.category}</span>
                      <time datetime={pubDateStr} class="text-muted-kk small">{pubDateStr}</time>
                    </div>
                    <h3 class="h6 font-heading fw-bold mt-2 mb-1">{post.data.title}</h3>
                    {post.data.description && (
                      <p class="text-muted-kk small mb-0">{post.data.description}</p>
                    )}
                  </div>
                </a>
              </div>
            </div>
          );
        })}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-5 border rounded-2 bg-surface">
          <p class="text-muted-kk mb-0">No articles published by this author yet.</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
