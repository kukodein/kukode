---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Get homepage content
const homepageEntries = await getCollection('homepage');
const homeData = homepageEntries.find(e => e.id.startsWith('en/'));

const site = Astro.site?.toString().replace(/\/$/, '') || 'https://kukode.com';

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Kukode",
  "url": site,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does a project take?",
      "acceptedAnswer": { "@type": "Answer", "text": "Usually 2–4 weeks depending on complexity." }
    },
    {
      "@type": "Question",
      "name": "Can I request a custom design?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, we tailor every design to your brand." }
    },
    {
      "@type": "Question",
      "name": "How does payment work?",
      "acceptedAnswer": { "@type": "Answer", "text": "50% deposit upfront, remainder on completion." }
    },
    {
      "@type": "Question",
      "name": "Is hosting included?",
      "acceptedAnswer": { "@type": "Answer", "text": "Depends on the plan — see Pricing for details." }
    },
    {
      "@type": "Question",
      "name": "How many revisions are included?",
      "acceptedAnswer": { "@type": "Answer", "text": "Typically 2–3 rounds, depending on your plan." }
    },
    {
      "@type": "Question",
      "name": "Is there support after launch?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, support period varies by plan." }
    },
    {
      "@type": "Question",
      "name": "How do I get started?",
      "acceptedAnswer": { "@type": "Answer", "text": "Reach out via the contact form or WhatsApp below." }
    },
    {
      "@type": "Question",
      "name": "Can you migrate from WordPress or into WordPress?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes — that's actually one of our specialties." }
    }
  ]
};

const title = homeData?.data?.seo_title || homeData?.data?.title || 'Kukode Digital Technology - Upgrade Your Web & Business';
const description = homeData?.data?.seo_description || homeData?.data?.description || "Kukode Digital Technology gives the services to improve your company's expansion & online presence.";

// Get latest posts
const allPosts = await getCollection('posts', ({ id, data }) =>
  id.startsWith('en/') && !data.draft
);
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  alternateEn={`${site}/`}
  alternateId={`${site}/id/`}
  schema={schema}
>
  <main class="kk-template-home">
    <!-- Hero Section -->
    <section id="section-hero" class="kk-hero pb-4 pt-1 py-lg-5 py-xxl-0">
      <div class="container kk-hero-content">
        <div class="row align-items-center g-4">
          <div class="col-lg-6 text-start order-lg-1 order-2">
            <div class="kk-badge-pill mb-4"><span class="kk-dot"></span>Accepting New Projects</div>
            <h1 class="mb-3">We build websites that genuinely work for your business.</h1>
            <p class="fs-5 text-muted-kk mb-4">Not just good-looking — every site we build is fast, professional, and designed to convert. You talk directly to the developer, to Us, Kukode. No middlemen, no guesswork.</p>
            <div class="d-flex gap-3">
              <a href="#contact" class="btn btn-primary">Get a Quote</a>
              <a href="#portfolio" class="btn btn-outline-kk">See Our Work</a>
            </div>
          </div>
          <div class="col-lg-6 order-lg-2 order-1">
            <div class="position-relative">
              <div class="kk-card p-2 border-0 bg-transparent">
                <img src="/image/en-home-section-hero.png" alt="Kukode product preview" class="img-fluid rounded-3 w-100" height="530" width="530" />
              </div>
              <div class="kk-float-card" style="position:absolute; top:100px; left:5px; background:var(--bs-body-bg); border-radius:var(--bs-border-radius-sm); box-shadow:0 20px 50px rgba(0,0,0,0.18); padding:0.75rem 1rem; font-size:0.8rem; font-weight:500;">⚡ 98/100 average site speed score</div>
              <div class="kk-float-card" style="position:absolute; bottom:100px; right:5px; background:var(--bs-body-bg); border-radius:var(--bs-border-radius-sm); box-shadow:0 20px 50px rgba(0,0,0,0.18); padding:0.75rem 1rem; font-size:0.8rem; font-weight:500;">🔍 Built SEO-ready from day one</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trusted By -->
    <section id="trusted" class="py-4 bg-light position-relative" style="z-index: 1;">
      <div class="container">
        <p class="text-center small mb-4">Businesses we've helped go online</p>
        <div class="kk-logo-strip">
          <span>Acme</span><span>Northwind</span><span>Globex</span><span>Initech</span><span>Umbrella</span><span>Soylent</span>
        </div>
      </div>
    </section>

    <!-- Marquee -->
    <section id="section-marquee" class="marquee-wrap">
      <div class="marquee-track">
        <div class="marquee-item">Company Profile</div>
        <div class="marquee-item">Landing Page</div>
        <div class="marquee-item">Toko Online</div>
        <div class="marquee-item">Redesign Website</div>
        <div class="marquee-item">WordPress</div>
        <div class="marquee-item">Next.js</div>
        <div class="marquee-item">UI/UX Figma</div>
        <div class="marquee-item">WooCommerce</div>
        <div class="marquee-item">SEO Ready</div>
        <div class="marquee-item">Mobile First</div>
        <div class="marquee-item">Company Profile</div>
        <div class="marquee-item">Landing Page</div>
        <div class="marquee-item">Toko Online</div>
        <div class="marquee-item">Redesign Website</div>
        <div class="marquee-item">WordPress</div>
        <div class="marquee-item">Next.js</div>
        <div class="marquee-item">UI/UX Figma</div>
        <div class="marquee-item">WooCommerce</div>
        <div class="marquee-item">SEO Ready</div>
        <div class="marquee-item">Mobile First</div>
      </div>
    </section>

    <!-- Key Metrics -->
    <section id="numbers" class="kk-section">
      <div class="container">
        <div class="row g-4 text-center">
          <div class="col-6 col-md-3"><div class="kk-stat-num">120+</div><p class="text-muted-kk small mb-0">Websites launched</p></div>
          <div class="col-6 col-md-3"><div class="kk-stat-num">98</div><p class="text-muted-kk small mb-0">Avg. site speed score</p></div>
          <div class="col-6 col-md-3"><div class="kk-stat-num">5yr</div><p class="text-muted-kk small mb-0">Building websites</p></div>
          <div class="col-6 col-md-3"><div class="kk-stat-num">99%</div><p class="text-muted-kk small mb-0">Clients who'd hire us again</p></div>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about-us" class="kk-section kk-gradient-alt">
      <div class="container">
        <div class="row align-items-center g-4">
          <div class="col-lg-6">
            <img src="/image/en-home-section-tentang.png" alt="Kukode team at work" class="img-fluid" width="546" height="364" loading="lazy" />
          </div>
          <div class="col-lg-6">
            <p class="kk-eyebrow mb-2">About Kukode</p>
            <h2 class="mb-3">A web development team that thinks like a business owner.</h2>
            <p>We don't just write code. We make sure every website is a genuine business tool. Every design and technical decision is made with your end users and growth goals in mind, not just what looks good on a screen.</p>
            <p>Indonesia-based, remote-ready, and fully committed to every project. You deal directly with Us — the person designing, coding, and delivering your site. No sales reps. No account managers. No end-of-project surprises.</p>
            <a href="/about/" class="btn btn-outline-kk">Learn more about us</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="kk-section">
      <div class="container">
        <div class="text-center mb-5">
          <p class="kk-eyebrow mb-2">Services</p>
          <h2>What can We help you with your business?</h2>
          <p>From a brand-new site to a full overhaul of what you already have — every project is built by me, to the same high standard.</p>
        </div>
        <div class="row g-3">
          <div class="col-6 col-md-8"><div class="kk-card p-4 kk-why-card"><div class="kk-icon-circle">💻</div><h3 class="h6 font-heading fw-bold mb-1">Development</h3><p class="text-muted-kk small mb-0">Hand-built websites, coded to load fast.</p></div></div>
          <div class="col-6 col-md-4"><div class="kk-card p-4 kk-why-card"><div class="kk-icon-circle">🎨</div><h3 class="h6 font-heading fw-bold mb-1">Web design</h3><p class="text-muted-kk small mb-0">Custom design that reflects your brand.</p></div></div>
          <div class="col-6 col-md-4"><div class="kk-card p-4 kk-why-card"><div class="kk-icon-circle">🛒</div><h3 class="h6 font-heading fw-bold mb-1">Online Store</h3><p class="text-muted-kk small mb-0">E-commerce sites ready to take orders and payments.</p></div></div>
          <div class="col-6 col-md-4"><div class="kk-card p-4 kk-why-card"><div class="kk-icon-circle">🔍</div><h3 class="h6 font-heading fw-bold mb-1">SEO Optimization</h3><p class="text-muted-kk small mb-0">On-page SEO built in from the start.</p></div></div>
          <div class="col-6 col-md-4"><div class="kk-card p-4 kk-why-card"><div class="kk-icon-circle">🛠️</div><h3 class="h6 font-heading fw-bold mb-1">Website Maintenance</h3><p class="text-muted-kk small mb-0">Ongoing updates, monitoring, and fixes.</p></div></div>
          <div class="col-6 col-md-4"><div class="kk-card p-4 kk-why-card"><div class="kk-icon-circle">🚀</div><h3 class="h6 font-heading fw-bold mb-1">Hosting & Deployment</h3><p class="text-muted-kk small mb-0">Fast, reliable hosting setup.</p></div></div>
          <div class="col-6 col-md-4"><div class="kk-card p-4 kk-why-card"><div class="kk-icon-circle">📱</div><h3 class="h6 font-heading fw-bold mb-1">Mobile-Friendly</h3><p class="text-muted-kk small mb-0">Built to look and work great on phones first.</p></div></div>
          <div class="col-6 col-md-4"><div class="kk-card p-4 kk-why-card"><div class="kk-icon-circle">📈</div><h3 class="h6 font-heading fw-bold mb-1">Analytics & Tracking</h3><p class="text-muted-kk small mb-0">Know exactly how visitors find and use your site.</p></div></div>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section id="process" class="kk-section kk-gradient-alt">
      <div class="container">
        <div class="text-center mb-5">
          <p class="kk-eyebrow mb-2">How We Work</p>
          <h2>Simple, transparent, no drama.</h2>
          <p class="mx-auto" style="max-width:560px;">From the first conversation to launch day — you always know exactly where your project stands.</p>
        </div>
        <div class="row g-3">
          {[
            { num: '1', title: 'Discovery Meet', desc: 'We talk through your business, goals, and what your current site is missing.' },
            { num: '2', title: 'Design', desc: "You'll see wireframes first, then a full visual design matching your brand." },
            { num: '3', title: 'Development', desc: 'We build the real thing — fast, responsive, and ready for search engines.' },
            { num: '4', title: 'Testing & Review', desc: 'We test across devices, check page speed and SEO, then walk through it with you.' },
            { num: '5', title: 'Launch & Support', desc: 'Your site goes live, and we stay on to handle anything that comes up.' },
          ].map(step => (
            <div class="col-md-4 col-lg">
              <div class="kk-card p-4 kk-step-card">
                <div class="kk-step-circle" style="margin:0 0 0.9rem;">{step.num}</div>
                <h3 class="h6 font-heading fw-bold mb-1">{step.title}</h3>
                <p class="text-muted-kk small mb-0">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Portfolio -->
    <section id="portfolio" class="kk-section">
      <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-5">
          <div>
            <p class="kk-eyebrow mb-2">Our Work</p>
            <h2 class="mb-0">Work that speaks for itself.</h2>
          </div>
          <a href="/portfolio/" class="btn btn-outline-kk btn-sm">See All Projects</a>
        </div>
        <div class="row g-3">
          {[41, 42, 43, 44, 45, 46].map((id, i) => (
            <div class="col-6 col-lg-4">
              <a href="#" class="kk-portfolio-card text-decoration-none text-reset d-block">
                <div class="kk-browser-frame">
                  <div class="kk-browser-bar"><span></span><span></span><span></span></div>
                  <div class="kk-browser-body">
                    <img src={`https://picsum.photos/600/400?${id}`} alt={`Project ${i + 1}`} width="600" height="400" loading="lazy" />
                    <div class="kk-overlay"><span class="btn btn-light btn-sm rounded-pill">View project</span></div>
                  </div>
                </div>
                <div class="m-2">
                  <p class="text-muted-kk small mt-2 mb-1">{['Company Profile', 'E-Commerce', 'Landing Page', 'Blog', 'Portfolio', 'Web App'][i]}</p>
                  <h3 class="h6 font-heading fw-bold">Project {['One', 'Two', 'Three', 'Four', 'Five', 'Six'][i]}</h3>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Tech Stack -->
    <section id="stack" class="kk-section kk-gradient-alt">
      <div class="container">
        <div class="row g-4 align-items-start">
          <div class="col-lg-4">
            <div class="kk-eyebrow mb-2">Tech Stack</div>
            <h2 class="mb-3">Built with the right tools.</h2>
            <p>No chasing trends. Every tool is chosen because it consistently delivers the best outcome for the client's business.</p>
          </div>
          <div class="col-lg-8">
            <div class="row g-4">
              {[
                { category: 'Frontend', items: ['HTML5', 'CSS3 / SCSS', 'JavaScript', 'Tailwind CSS', 'Next.js'] },
                { category: 'Backend & CMS', items: ['WordPress', 'Elementor Pro', 'WooCommerce', 'PHP 8'] },
                { category: 'Design & Tools', items: ['Figma', 'Canva Pro', 'Git / GitHub', 'Yoast SEO', 'Cloudflare'] },
                { category: 'Payment & API', items: ['Midtrans', 'Xendit', 'WhatsApp API'] },
                { category: 'Analytics & SEO', items: ['Google Analytics', 'Search Console', 'PageSpeed'] },
                { category: 'Hosting', items: ['Niagahoster', 'Hostinger', 'cPanel'] },
              ].map(tech => (
                <div class="col-md-4">
                  <div class="text-uppercase text-secondary fw-bold fs-7 mb-2">{tech.category}</div>
                  <div class="d-flex flex-wrap gap-2">
                    {tech.items.map(item => <span class="tp-pill">{item}</span>)}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section id="testimony" class="kk-section">
      <div class="container">
        <div class="text-center mb-5">
          <p class="kk-eyebrow mb-2">Testimonials</p>
          <h2>Straight from the people we've worked with.</h2>
        </div>
        <div class="row g-3 pt-2">
          {[
            { quote: '"Our new site loads in under a second and our inquiries doubled in the first month."', name: 'Budi Santoso', title: 'CEO, Company A', icon: '👨‍💼' },
            { quote: '"I can update the site myself without calling anyone — that alone was worth it."', name: 'Sari Dewi', title: 'Owner, Store B', icon: '👩' },
            { quote: '"They actually explained what they were doing instead of just sending invoices."', name: 'Andi Wijaya', title: 'Marketing, Startup C', icon: '👨‍⚕️' },
            { quote: '"Finally a website that looks like it belongs to 2026, not 2015"', name: 'Rina Putri', title: 'Founder, Brand D', icon: '👩' },
          ].map(testimonial => (
            <div class="col-md-6 col-lg-3">
              <div class="kk-card p-4 h-100">
                <p class="mb-4">{testimonial.quote}</p>
                <div class="d-flex align-items-center gap-3">
                  <div class="kk-icon-circle mb-0">{testimonial.icon}</div>
                  <div>
                    <p class="fw-bold mb-0 small">{testimonial.name}</p>
                    <p class="text-muted-kk small mb-0">{testimonial.title}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Kukode -->
    <section id="why-kukode" class="kk-section bg-surface">
      <div class="container">
        <div class="text-center mb-5">
          <p class="kk-eyebrow mb-2">Why Kukode</p>
          <h2>Here's what makes us genuinely different.</h2>
          <p class="text-muted-kk mx-auto" style="max-width:560px;">Eight reasons clients come back for their next project.</p>
        </div>
        <div class="row g-3">
          {[
            { icon: '🎯', title: 'Direct access to your developer', desc: 'No sales reps or project managers in between.' },
            { icon: '⚡', title: 'Launched in weeks', desc: 'An efficient process gets you live in weeks, not months.' },
            { icon: '🔒', title: 'Secure by default', desc: 'Modern hosting means far fewer security headaches.' },
            { icon: '🎯', title: 'Built around your goals', desc: 'Every site is built around your content and goals.' },
            { icon: '💬', title: 'Clear communication', desc: 'Regular updates so you always know where the project stands.' },
            { icon: '📊', title: 'SEO-friendly', desc: 'Built with technical SEO best practices from day one.' },
            { icon: '🔄', title: 'Flexible revisions', desc: 'Room to iterate so the result matches your vision.' },
            { icon: '💰', title: 'Transparent pricing', desc: "No hidden fees — what's quoted is what you pay." },
            { icon: '🤝', title: 'Post-launch support', desc: 'We stick around after launch to help you grow.' },
          ].map(item => (
            <div class={item.icon === '🎯' && item.title.includes('Direct') ? 'col-12 col-md-4' : 'col-6 col-md-4'}>
              <div class="kk-card p-4 kk-why-card">
                <div class="kk-icon-circle">{item.icon}</div>
                <h3 class="h6 font-heading fw-bold mb-1">{item.title}</h3>
                <p class="text-muted-kk small mb-0">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="kk-section kk-gradient-alt">
      <div class="container">
        <div class="text-center mb-5">
          <p class="kk-eyebrow mb-2">Pricing</p>
          <h2>An investment that actually makes sense.</h2>
          <p>No project is too small or too large. Everything is tailored to what you actually need.</p>
        </div>
        <div class="row g-3 align-items-stretch">
          {[
            {
              name: 'Starter', price: 'IDR 800K', usd: '≈ USD 50 / project', popular: false,
              desc: 'For businesses just stepping into the digital world.',
              features: ['Single-page landing page', 'Fully responsive design', 'WhatsApp button & contact form', 'Figma mockup before coding', 'Delivered in 3–5 working days'],
              cta: "Let's Talk", ctaClass: 'btn-outline-kk'
            },
            {
              name: 'Professional', price: 'IDR 1.5M', usd: '≈ USD 95 / project', popular: true,
              desc: 'For businesses that want to look the part and win client trust.',
              features: ['4–6 page company profile', 'Figma mockup + design revisions', 'Basic on-page SEO setup', 'Google Analytics configured', 'Open revisions within scope', 'Delivered in 7–10 working days'],
              cta: 'Choose This Plan', ctaClass: 'btn-primary'
            },
            {
              name: 'E-Commerce', price: 'IDR 2.5M', usd: '≈ USD 158 / project', popular: false,
              desc: 'For businesses ready to sell online — commission-free.',
              features: ['Full WooCommerce store setup', 'Product catalog & inventory management', 'Payment gateway integration', 'Automatic shipping calculator', 'Admin panel training included'],
              cta: "Let's Talk", ctaClass: 'btn-outline-kk'
            }
          ].map(plan => (
            <div class="col-lg-4">
              <div class={`kk-card p-4 h-100 ${plan.popular ? 'kk-pricing-popular' : ''}`}>
                <h3 class="h5 font-heading fw-bold mb-0">
                  {plan.name} {plan.popular && <span class="badge rounded-pill text-bg-primary fw-normal">Most popular</span>}
                </h3>
                <div class="fs-3 fw-bold">{plan.price}</div>
                <div class="mb-3">{plan.usd}</div>
                <div class="text-muted">{plan.desc}</div>
                <hr style="border-color:var(--bs-border-color)" />
                {plan.features.map(f => (
                  <div class="d-flex align-items-center">
                    <img src="/image/StreamlineColorCheckSquare.png" alt="✓" class="me-2 w-16px" width="16" height="16" loading="lazy" />{f}
                  </div>
                ))}
                <a href="#contact" class={`btn w-100 mt-4 ${plan.ctaClass}`}>{plan.cta}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Blog -->
    <section id="blog" class="kk-section">
      <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
          <div>
            <p class="kk-eyebrow mb-2">Blog</p>
            <h2 class="mb-0">Latest Articles</h2>
          </div>
          <a href="/article/" class="btn btn-outline-kk btn-sm">View All</a>
        </div>
        <div class="row g-3">
          {latestPosts.map(post => {
            const slug = post.data.custom_slug || post.id.replace(/^en\//, '');
            return (
              <div class="col-md-4">
                <div class="kk-card p-2">
                  <a href={`/article/${slug}`} class="text-decoration-none text-reset">
                    {post.data.image && (
                      <img src={post.data.image} alt={post.data.title} class="img-fluid rounded-3 w-100 aspect-ratio-16-9 bg-light" style="min-height:100px;" loading="lazy" />
                    )}
                    <div class="m-2">
                      <div id="meta-post" class="d-flex justify-content-between mt-3">
                        <span class="text-muted-kk small text-uppercase">{post.data.category}</span>
                        <time datetime={post.data.pubDate.toISOString().split('T')[0]} class="text-muted-kk small mb-1 d-block">{post.data.pubDate.toISOString().split('T')[0]}</time>
                      </div>
                      <h3 class="h6 font-heading mt-2">{post.data.title}</h3>
                    </div>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="kk-section bg-surface">
      <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(faqSchema)}</script>`} />
      <div class="container">
        <div class="row g-4">
          <div class="col-lg-4">
            <div class="kk-eyebrow mb-2">FAQ</div>
            <h2 class="mb-3">Questions we hear all the time.</h2>
            <p class="mb-4">Don't see yours here? Just ask — I reply personally to every message.</p>
            <a href="https://wa.me/6281234567890" class="btn btn-primary" target="_blank">Message Me Directly</a>
          </div>
          <div class="col-lg-8">
            {[
              { q: 'How long does a project take?', a: 'Usually 2–4 weeks depending on complexity.' },
              { q: 'Can I request a custom design?', a: 'Yes, we tailor every design to your brand.' },
